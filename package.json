{
  "name": "nkdk",
  "version": "0.0.3",
  "private": true,
  "description": "NKDK. Редактор конфигурации 1С на языке YAML. Только для ИИ Агентов.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "26.4.x",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lmdb"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:rust:fast": "python3 tools/rust-build-profile/build.py --parallel-frontend build",
    "test:rust:app:fast": "python3 tools/rust-build-profile/build.py --parallel-frontend test",
    "build:rust": "python3 tools/rust-build-profile/build.py build",
    "test:rust:app": "python3 tools/rust-build-profile/build.py test",
    "architecture:baseline": "node tools/dependency-cruiser/src/baseline.mjs",
    "architecture:cycle-baseline": "node tools/dependency-cruiser/src/cycle-baseline-update.mjs",
    "architecture:graph": "node tools/dependency-cruiser/src/graph.mjs",
    "architecture:report": "node tools/dependency-cruiser/src/report.mjs",
    "check:duplicates": "node scripts/check-new-duplicates.mjs",
    "duplicates": "node scripts/check-new-duplicates.mjs",
    "fixtures:e2e:nkdk": "pnpm --filter @nkdk/rules exec tsx ../../e2e/update-nkdk-fixture.ts",
    "type-check": "pnpm --filter \"./packages/*\" -r exec tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "pnpm test:round-trip-batch && pnpm test:duplicates-script && pnpm test:unit-boundaries && pnpm test:migration-inventory && pnpm -r --workspace-concurrency=1 run test",
    "test:migration-inventory": "node --test tools/rules-migration/test/*.test.mjs",
    "migration:inventory": "node tools/rules-migration/src/cli.mjs",
    "migration:extract": "node tools/rules-migration/src/extract-cli.mjs",
    "migration:candidates": "node tools/rules-migration/src/emit-cli.mjs",
    "migration:families": "node tools/rules-migration/src/family-requirements-cli.mjs",
    "test:migration:input-by-string:working": "node tools/rules-migration/src/working-check.mjs --manifest tests/migration/input-by-string-working.json",
    "migration:events:working": "node tools/rules-migration/src/events-working-cli.mjs",
    "test:migration:events:working": "node tools/rules-migration/src/working-check.mjs --manifest tests/migration/events-working.json",
    "test:migration-family": "node tools/rules-migration/src/family-check.mjs",
    "migration:working-family": "node tools/rules-migration/src/working-family-cli.mjs",
    "migration:common-family": "node tools/rules-migration/src/common-family-cli.mjs",
    "migration:shared-aot": "node tools/rules-migration/src/shared-aot-cli.mjs",
    "build:rust:prepare": "node tools/rules-migration/src/shared-aot-cli.mjs --production-group bodies-5 --output rust/generated-aot/bodies-5 --prepared-sources rust/prepared-aot/bodies-5",
    "test:round-trip-batch": "node --test scripts/round-trip-batch.test.mjs scripts/round-trip-statistics.test.mjs scripts/normalize-xml-line-endings.test.mjs .agents/tools/mcp/build-compiled.test.mjs",
    "test:duplicates-script": "node --test scripts/check-new-duplicates.test.mjs",
    "test:unit-boundaries": "node --test scripts/unit-test-dependency-boundaries.test.mjs scripts/metadata-test-runner-lifetime.test.mjs && node scripts/check-unit-test-dependencies.mjs",
    "test:isolated": "pnpm -r --workspace-concurrency=1 run test:isolated",
    "test:architecture:rust": "node --test tools/rust-architecture/check.test.mjs && node tools/rust-architecture/check.mjs",
    "test:architecture": "node tools/dependency-cruiser/src/check.mjs",
    "test:architecture:rules": "node --test 'tools/dependency-cruiser/test/*.test.mjs'",
    "test:profile": "node packages/rules/scripts/run-test-duration-profile.mjs",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "test:partial-sync": "pnpm --filter @nkdk/mcp build && tsx e2e/partial-sync/run.ts",
    "test:partial-sync:stepwise": "pnpm --filter @nkdk/mcp build && tsx e2e/partial-sync/stepwise-run.ts",
    "migration:contracts": "node tools/rules-migration/src/contracts-cli.mjs",
    "migration:standard-attributes": "node tools/rules-migration/src/standard-attributes-operation.mjs",
    "test:migration-contracts": "node tools/rules-migration/src/contracts-check.mjs",
    "migration:check:focused": "node tools/rules-migration/src/focused-check.mjs",
    "migration:attachments": "node tools/rules-migration/src/ready-cli.mjs",
    "test:migration-attachments": "node tools/rules-migration/src/ready-check.mjs",
    "migration:collections": "node tools/rules-migration/src/collections-cli.mjs",
    "migration:form-elements": "node tools/rules-migration/src/element-links-cli.mjs",
    "migration:form-element-identities": "node tools/rules-migration/src/element-identity-cli.mjs",
    "migration:form-element-assemblies": "node tools/rules-migration/src/element-assembly-cli.mjs",
    "test:migration-resource-facts": "node tools/rules-migration/src/resource-facts-check.mjs",
    "test:migration-collections": "node tools/rules-migration/src/collections-check.mjs",
    "migration:tooltip:working": "node tools/rules-migration/src/tooltip-working-cli.mjs",
    "test:migration:tooltip:working": "node tools/rules-migration/src/working-check.mjs --manifest tests/migration/tooltip-working.json"
  },
  "devDependencies": {
    "@nkdk/platform": "workspace:*",
    "@nkdk/runtime": "workspace:*",
    "@types/node": "^26.1.2",
    "jscpd": "5.0.12",
    "tsx": "^4.23.1",
    "tsc-alias": "^1.9.1",
    "typescript": "~7.0.0",
    "vitest": "^4.1.10"
  }
}
