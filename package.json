{
  "name": "nkdk",
  "version": "0.0.3",
  "private": true,
  "description": "NKDK. Редактор конфигурации 1С на языке YAML. Только для ИИ Агентов.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "architecture:baseline": "node tools/dependency-cruiser/src/baseline.mjs",
    "architecture:graph": "node tools/dependency-cruiser/src/graph.mjs",
    "architecture:report": "node tools/dependency-cruiser/src/report.mjs",
    "type-check": "pnpm -r exec tsc --noEmit",
    "test": "pnpm -r run test",
    "test:isolated": "pnpm -r run test:isolated",
    "test:architecture": "node tools/dependency-cruiser/src/check.mjs",
    "test:architecture:rules": "node --test 'tools/dependency-cruiser/test/*.test.mjs'",
    "test:profile": "node packages/core/scripts/run-test-duration-profile.mjs",
    "test:mutation": "node packages/core/scripts/run-mutation-tests.mjs",
    "test:mutation:compare": "node packages/core/scripts/compare-mutation-reports.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^26.1.2",
    "tsc-alias": "^1.9.1",
    "typescript": "~7.0.0",
    "vitest": "^4.1.10"
  }
}
