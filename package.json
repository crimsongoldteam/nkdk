  },
  "homepage": "https://github.com/your-username/nakidka-core#readme",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "^3.2.4",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "fast-xml-parser": "^5.2.5",
    "tsyringe": "^4.10.0",
    "zod": "^4.1.5"
  }
