{
  "name": "nakidka-web",
  "version": "1.0.0",
  "description": "Монорепозиторий Nakidka для работы с конфигурациями 1С",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "type-check": "pnpm -r exec tsc --noEmit",
    "test": "pnpm -r run test",
    "test:isolated": "pnpm -r run test:isolated",
    "prepare": "ts-patch install"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "prettier": "^3.8.1",
    "ts-patch": "^3.3.0",
    "tsc-alias": "^1.8.16",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "change-case": "^5.4.4",
    "chevrotain": "^11.2.0",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "^5.4.2",
    "uuid": "^13.0.0",
    "yaml": "^2.8.3"
  }
}
