{
  "name": "nakidka-web",
  "version": "1.0.0",
  "description": "Веб-приложение для расширения VS Code Nakidka",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "type-check": "pnpm -r exec tsc --noEmit",
    "test": "pnpm -r run test",
    "prepare": "ts-patch install",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.109.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "baseline-browser-mapping": "^2.10.0",
    "concurrently": "^9.2.1",
    "jsdom": "^27.4.0",
    "organize-imports-cli": "^0.10.0",
    "patch-package": "^8.0.1",
    "pointer-events-polyfill": "0.4.4-pre",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.8.1",
    "resize-observer-polyfill": "^1.5.1",
    "terser": "^5.46.0",
    "ts-loader": "^9.5.4",
    "ts-patch": "^3.3.0",
    "tsc-alias": "^1.8.16",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@ant-design/icons": "~6.1.0",
    "@babel/standalone": "^7.29.1",
    "@monaco-editor/react": "^4.7.0",
    "antd": "^6.3.1",
    "change-case": "^5.4.4",
    "chevrotain": "^11.2.0",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "^5.4.2",
    "monaco-editor-core": "0.55.1",
    "performance-polyfill": "^0.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rollup": "^4.59.0",
    "split.js": "^1.6.5",
    "uuid": "^13.0.0",
    "whatwg-fetch": "^3.6.20",
    "yaml": "^2.8.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "fast-xml-builder@1.0.0": "patches/fast-xml-builder@1.0.0.patch"
    }
  }
}
