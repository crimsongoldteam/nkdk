{
  "name": "nakidka-web",
  "version": "1.0.0",
  "description": "Монорепозиторий Nakidka для работы с конфигурациями 1С",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "type-check": "pnpm -r exec tsc --noEmit",
    "test": "pnpm -r run test",
    "test:isolated": "pnpm -r run test:isolated",
    "prepare": "ts-patch install"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "prettier": "^3.8.4",
    "ts-patch": "^3.3.0",
    "tsc-alias": "^1.8.17",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9"
  }
}
