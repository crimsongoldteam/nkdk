{
  "name": "nakidka-core",
  "version": "1.0.0",
  "description": "A TypeScript library for form management with FormGroup class",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run clean && npm run build",
    "dev": "ts-node src/index.ts",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest"
  },
  "keywords": [
    "typescript",
    "form",
    "formgroup",
    "validation",
    "reactive-forms"
  ],
  "author": "",
