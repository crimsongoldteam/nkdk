{
  "name": "nakidka-web",
  "version": "1.0.0",
  "description": "Веб-приложение для расширения VS Code Nakidka",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run --no-deprecation",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "prepare": "ts-patch install"
  },
  "devDependencies": {
    "@ryoppippi/unplugin-typia": "^2.6.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.106.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.15",
    "baseline-browser-mapping": "^2.9.3",
    "concurrently": "^9.2.1",
    "jsdom": "^27.2.0",
    "organize-imports-cli": "^0.10.0",
    "pointer-events-polyfill": "0.4.4-pre",
    "prettier": "^3.7.4",
    "resize-observer-polyfill": "^1.5.1",
    "terser": "^5.44.1",
    "ts-loader": "^9.5.4",
    "ts-patch": "^3.3.0",
    "tsc-alias": "^1.8.16",
    "typescript": "~5.9.3",
    "typia": "^10.1.0",
    "vite": "^7.2.6",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@ant-design/icons": "~6.1.0",
    "@babel/standalone": "^7.28.5",
    "@monaco-editor/react": "^4.7.0",
    "antd": "^6.0.1",
    "big-integer": "^1.6.52",
    "change-case": "^5.4.4",
    "chevrotain": "^11.0.3",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "^5.3.2",
    "monaco-editor-core": "0.55.1",
    "performance-polyfill": "^0.0.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "rollup": "^4.53.3",
    "seedrandom": "^3.0.5",
    "split.js": "^1.6.5",
    "uuid": "^13.0.0",
    "whatwg-fetch": "^3.6.20",
    "yaml": "^2.8.2",
    "zod": "^4.1.13"
  }
}
