{
  "name": "nakidka-core",
  "version": "1.0.0",
  "description": "Management forms and metadata for 1C:Enterprise-like systems",
  "main": "out/src/extension.js",
  "types": "out/src/extension.d.ts",
  "files": [
    "out/**/*",
    "README.md"
  ],
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p tsconfig.extension.json && tsc-alias -p tsconfig.extension.json && node scripts/copy-lib.js",
    "build": "tsc && tsc-alias",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "dev": "ts-node src/index.ts",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest",
    "web:build": "cd web && pnpm build",
    "web:build:lib": "cd web && pnpm build:lib",
    "web:build:watch": "cd web && pnpm build:watch",
    "web:build:lib:watch": "cd web && pnpm build:lib:watch",
    "web:watch": "cd web && pnpm watch",
    "web:dev": "cd web && pnpm dev",
    "build:all": "pnpm web:build:lib && pnpm compile",
    "build:all:watch": "concurrently \"pnpm watch\" \"pnpm web:build:lib:watch\"",
    "copy:lib": "node scripts/copy-lib.js"
  },
  "keywords": [
    "typescript",
    "form",
    "formgroup",
    "validation",
    "reactive-forms"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crimsongoldteam/nakidka-core.git"
  },
  "bugs": {
    "url": "https://github.com/crimsongoldteam/nakidka-core/issues"
  },
  "homepage": "https://github.com/crimsongoldteam/nakidka-core",
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "jsdom": "^27.0.0",
    "path": "^0.12.7",
    "typescript": "~5.8.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@babel/standalone": "^7.28.4"
  },
  "engines": {
    "vscode": "^1.99.0",
    "node": ">=18.0.0"
  },
  "type": "commonjs",
  "bundledDependencies": [],
  "exports": {
    ".": {
      "import": "./out/src/extension.js",
      "require": "./out/src/extension.js",
      "types": "./out/src/extension.d.ts"
    }
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "catCustoms.catScratch",
        "displayName": "Cat Scratch",
        "selector": [
          {
            "filenamePattern": "*.xml"
          }
        ]
      }
    ]
  }
}
