{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@nakidka/core": ["../core/index.ts"],
      "@nakidka/graph": ["../graph/src/index.ts"],
      "~/*": ["../core/*"]
    }
  },
  "references": [
    {
      "path": "../language/tsconfig.src.json"
    }
  ],
  "include": ["src/**/*.ts"]
}
