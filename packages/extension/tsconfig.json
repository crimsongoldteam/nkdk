{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@nakidka/core": ["../core/index.ts"],
      "src/*": ["./src/*"],
      "~/*": ["../core/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
