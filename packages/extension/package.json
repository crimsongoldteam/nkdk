{
  "name": "nkdk",
  "description": "The extension for 1C:Enterprise configuration in YAML format",
  "publisher": "nikita-zherebtsov",
  "version": "0.0.1",
  "displayName": "nkdk",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "commands": [
      {
        "command": "nkdk.importConfigurationFromXml",
        "title": "nkdk: Импорт конфигурации из XML"
      },
      {
        "command": "nkdk.syncConfigurationToXml",
        "title": "nkdk: Синхронизация конфигурации с XML"
      }
    ],
    "languages": [
      {
        "id": "yaml",
        "aliases": [
          "yaml"
        ],
        "extensions": [
          ".yaml"
        ],
        "configuration": "./language-configuration-yaml.json"
      }
    ]
  },
  "main": "./out/extension/extension.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/crimsongoldteam/nkdk"
  },
  "scripts": {
    "clean": "shx rm -fr *.tsbuildinfo ./out",
    "vscode:prepublish": "pnpm run build",
    "build": "tsc -b tsconfig.json && node esbuild.mjs && pnpm run copy-l10n",
    "build:clean": "pnpm run clean && pnpm run build",
    "copy-l10n": "cp -r node_modules/yaml-language-server/l10n out/extension/l10n",
    "watch": "concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json --watch\" \"node esbuild.mjs --watch\"",
    "package": "pnpm run build && pnpm exec vsce package --out ./out"
  },
  "dependencies": {
    "@nakidka/core": "workspace:*",
    "fs-extra": "~11.2.0",
    "request-light": "^0.8.0",
    "vscode-languageclient": "~9.0.1",
    "yaml": "^2.8.3",
    "yaml-language-server": "next"
  },
  "devDependencies": {
    "@types/fs-extra": "~11.0.4",
    "@types/vscode": "~1.67.0",
    "@vscode/vsce": "~3.7.1",
    "concurrently": "~8.2.1",
    "esbuild": "~0.25.5",
    "shx": "~0.3.4"
  },
  "vsce": {
    "dependencies": false
  }
}
