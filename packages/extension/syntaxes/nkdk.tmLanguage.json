{
  "name": "nkdk",
  "scopeName": "source.nkdk",
  "fileTypes": ["nkdk"],
  "patterns": [
    { "include": "#string" },
    { "include": "#otherfield" },
    { "include": "#operator" },
    { "include": "#picture" },
    { "include": "#checkbox" },
    { "include": "#autofill" },
    { "include": "#pages" },
    { "include": "#autocommandbar" },
    { "include": "#group" },
    { "include": "#field-prefix" },
    { "include": "#bracket" },
    { "include": "#punctuation" },
    { "include": "#name" }
  ],
  "repository": {
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.nkdk",
          "match": "\"(?:[^\"]|\"\")*\""
        },
        {
          "name": "string.quoted.single.nkdk",
          "match": "'(?:[^']|'')*'"
        }
      ]
    },
    "otherfield": {
      "name": "support.type.nkdk",
      "match": "\\?(УправлениеПоиском|ОтображениеСтрокиПоиска|ПолеКалендаря|ПолеФорматированногоДокумента|ПолеДиаграммыГанта|ПолеГеографическойСхемы|ПолеГрафическойСхемы|ПолеHTMLДокумента|ПолеPDFДокумента|ПолеПериода|ПолеПланировщика|ПолеИндикатора|ПолеПереключателя|ПолеРисунка|ПолеТабличногоДокумента|ПолеТекстовогоДокумента|ПолеПолосыПрокрутки)"
    },
    "operator": {
      "name": "keyword.operator.nkdk",
      "match": "%[a-zA-Zа-яА-ЯёЁ_][a-zA-Zа-яА-ЯёЁ0-9_]*"
    },
    "picture": {
      "name": "entity.name.tag.nkdk",
      "match": "\\[[\\t ]*[a-zA-Zа-яА-ЯёЁ_][a-zA-Zа-яА-ЯёЁ0-9_.]*[\\t ]*\\]"
    },
    "checkbox": {
      "patterns": [
        {
          "name": "constant.language.nkdk",
          "match": "<\\|>"
        },
        {
          "name": "constant.language.nkdk",
          "match": "\\[\\|\\]"
        },
        {
          "name": "constant.language.nkdk",
          "match": "\\[\\]"
        }
      ]
    },
    "autofill": {
      "name": "keyword.control.nkdk",
      "match": "\\.\\.\\."
    },
    "pages": {
      "patterns": [
        {
          "name": "markup.heading.nkdk",
          "match": "//"
        },
        {
          "name": "markup.heading.nkdk",
          "match": "/"
        }
      ]
    },
    "autocommandbar": {
      "patterns": [
        {
          "name": "punctuation.definition.tag.nkdk",
          "match": "<<"
        },
        {
          "name": "punctuation.definition.tag.nkdk",
          "match": ">>"
        }
      ]
    },
    "group": {
      "name": "markup.bold.nkdk",
      "match": "(={2,5}|\\+{2,5}|-{2,5}|[=+\\-])"
    },
    "field-prefix": {
      "name": "keyword.other.nkdk",
      "match": "[!~]"
    },
    "bracket": {
      "patterns": [
        {
          "name": "punctuation.brackets.nkdk",
          "match": "[<>]"
        },
        {
          "name": "punctuation.brackets.nkdk",
          "match": "[()\\[\\]]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.nkdk",
          "match": ":"
        },
        {
          "name": "punctuation.separator.nkdk",
          "match": ";"
        },
        {
          "name": "punctuation.separator.nkdk",
          "match": "\\|"
        },
        {
          "name": "punctuation.accessor.nkdk",
          "match": "\\."
        }
      ]
    },
    "name": {
      "name": "variable.other.nkdk",
      "match": "[a-zA-Zа-яА-ЯёЁ_][a-zA-Zа-яА-ЯёЁ0-9_]*(?:\\[[0-9]+\\])?"
    }
  }
}
