{
  "name": "@nkdk/core",
  "version": "0.0.3",
  "description": "Ядро библиотеки NKDK для работы с метаданными и XML",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": {
      "import": "./index.ts"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run --no-isolate --sequence.shuffle",
    "test:isolated": "vitest run",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "measure:validation-schemas": "tsx --expose-gc scripts/measure-validation-schemas.mjs",
    "measure:validation-workers": "node scripts/measure-validation-workers.mjs",
    "prepare": "ts-patch install"
  },
  "dependencies": {
    "@node-rs/xxhash": "^1.7.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "date-fns": "^4.4.0",
    "fast-xml-parser": "^5.9.2",
    "js-yaml": "^5.2.1",
    "p-limit": "^6.2.0",
    "piscina": "^5.2.0",
    "typebox": "1.3.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.1",
    "ts-patch": "^3.3.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.0",
    "vitest": "^4.1.9"
  }
}
