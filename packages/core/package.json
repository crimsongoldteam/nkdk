{
  "name": "@nakidka/core",
  "version": "1.0.0",
  "description": "Ядро библиотеки Nakidka для работы с метаданными и XML",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": {
      "import": "./index.ts"
    }
  },
  "scripts": {
    "test": "vitest run --no-isolate --sequence.shuffle",
    "test:isolated": "vitest run",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "prepare": "ts-patch install"
  },
  "dependencies": {
    "@node-rs/xxhash": "^1.7.6",
    "@sinclair/typebox": "^0.34.49",
    "date-fns": "^4.4.0",
    "fast-xml-parser": "^5.9.2",
    "js-yaml": "^5.2.1",
    "p-limit": "^6.2.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.3",
    "ts-patch": "^3.3.0",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9"
  }
}
