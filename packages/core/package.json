{
  "name": "@nakidka/core",
  "version": "1.0.0",
  "description": "Ядро библиотеки Nakidka для работы с метаданными и XML",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": {
      "import": "./index.ts"
    }
  },
  "scripts": {
    "test": "vitest run --no-isolate --sequence.shuffle",
    "test:isolated": "vitest run",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "prepare": "ts-patch install"
  },
  "dependencies": {
    "@nakidka/graph": "workspace:*",
    "@sinclair/typebox": "^0.34.48",
    "p-limit": "^6.2.0",
    "change-case": "^5.4.4",
    "chevrotain": "^11.0.3",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "^5.4.2",
    "uuid": "^13.0.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.19.2",
    "ts-patch": "^3.3.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.15"
  }
}
