%{ГруппаРаспознаваниеДокумента} ?Надпись {РаспознаваниеДокументаНадпись}

%{ГруппаПереданВАрхивИлиУничтожен} @ИнформацияБЭД {ПереданВАрхивИлиУничтоженКартинка}; ?Надпись {ПереданВАрхивИлиУничтоженНадпись}

%{ГруппаПометкаУдаления} @ИнформацияБЭД {ПометкаУдаленияКартинка}; ?Надпись {ПометкаУдаленияНадпись}

%{ГруппаНеРедактируется}
  @Предупреждение32 {ДекорацияЗагруженИзВнешнейСистемы}
  #Группа не редактируется описание
    ?ПолеНадписи {НеРедактируетсяОписание}

%{ГруппаКомПанели} ?КоманднаяПанель {ГруппаОсновнаяКомПанель}; ?КоманднаяПанель {ГруппаВсеДействия}

%{ГруппаЗадач} ?Надпись {ДекорацияЗадач}; ?Кнопка {ПерейтиКВыполнениюЗадачи}

%{ГруппаПлашкаЭДО} ?Надпись {ДекорацияЭДО}

%{ГруппаДанные}
  %{МК_ГруппаПереключателиСтраниц}
    %{МК_ПереключателиПерваяСтрока} ?Кнопка {МК_КнопкаСтраницаОбзор}; ?Кнопка {МК_КнопкаСтраницаОсновное}; ?Кнопка {МК_КнопкаСтраницаФайлы}; ?Кнопка {МК_КнопкаСтраницаКонтрагенты}; ?Кнопка {МК_КнопкаСтраницаОбработка}
    %{МК_ПереключателиВтораяСтрока} ?Кнопка {МК_КнопкаСтраницаКатегории}; ?Кнопка {МК_КнопкаСтраницаЭП}; ?Кнопка {МК_КнопкаСтраницаРабочаяГруппа}
  //Страницы{ГруппаСтраницы}
    /Обзор
      %{ГруппаОбзорФайлы}
        #Группа файлы
          #{МК_ДеревоОбзора}
            %{МК_ДеревоОбзораКоманднаяПанель} ?Кнопка {МК_СоздатьФайл}; ?Надпись {МК_ДеревоОбзораЗаголовок}; ?Кнопка {МК_ПоказатьСкрытьДеревоОбзора}
          
          %{ДекорацияКоманды} ?КоманднаяПанель {ГруппаКоманды}
          
          
          %{ГруппаНадписьОтсутствуетОригинал} @Предупреждение {КартинкаОтсутствуетОригинал}; ?Надпись {ДекорацияОтсутствуетОригинал}
        #Группа представление HTML
          ;
          
          //Группа предпросмотр страницы{ГруппаПредпросмотрСтраницы}
            /{ГруппаHtml}
              %{ГруппаПредпросмотрУрезан} @Предупреждение {ДекорацияИконкаУрезан}; ?Надпись {ДекорацияПредпросмотрУрезан}
              
              ?ПолеHTMLДокумента {ПредставлениеHTML}
              ?КоманднаяПанель {ПереключениеСтраниц}
            /{ГруппаPdf}
              ;
            /Группа ЭДО
              //Группа ЭДО страницы{ГруппаЭДОСтраницы}
                /Группа ЭДО табличный
                  ?ПолеТабличногоДокумента {ТабличныйДокументЭДО}
            /Автопротокол {ГруппаТаймлистАвтопротокол}
              ?ПолеHTMLДокумента {ТаймлистАвтопротоколHTML}
            /Распознанный текст {ГруппаРаспознанныйТекст}
              ?ПолеHTMLДокумента {РаспознанныйТекстHTML}
          
          %{ГруппаСостояния}
            ?ПолеРисунка {КартинкаВзаимодействие}
            ?ПолеРисунка {КартинкаЭП}
            ?ПолеРисунка {КартинкаКатегории}
            ?ПолеРисунка {КартинкаФорум}
            ?ПолеРисунка {КартинкаКонтроль}
            ?ПолеРисунка {КартинкаСостояниеДела}
            ?ПолеРисунка {КартинкаЭДО}
    /Реквизиты {ГруппаОсновные}
      %{ГруппаЭлемента}
        ###Группа лево
          ?ПолеВвода {ВидИТематикаТекст}
          
          #Группа наименование код
            ?ПолеВвода {Заголовок}
          
          ?ПолеВвода {Содержание}
          
          %{ГруппаПредметПерепискиНесколько} ?ПолеВвода {ПредметПереписки}; ?Кнопка {НесколькоПредметовПереписки}
          
          %{ГруппаСписокПредметовПерепискиИКоманды}
            | Предметы переписки |
            #Групп команды списка предметов переписки
              ?Кнопка {СписокПредметовПерепискиДобавить}
              ?Кнопка {СписокПредметовПерепискиУдалить}
              ?Кнопка {ОдинПредметПереписки}
          
          #Наша организация {ГруппаОрганизация}
            ?Надпись {ДекорацияОрганизация}
            ?ПолеВвода {Организация}
            ?ПолеВвода {АдресатВходящейКорреспонденции}
            ?ПолеВвода {СпособПолучения}
            ?ПолеВвода {УтверждениеТекст}
            ?ПолеВвода {ПодписьТекст}
          
          %{ГруппаВОтветНаНесколько} ?ПолеВвода {ВОтветНаСтрока}; ?Кнопка {НесколькоВОтветНа}
          
          %{ГруппаСписокВОтветНаИКоманды}
            | В ответ на | В ответ на |
            #Группа команды списка в ответ на
              ?Кнопка {СписокВОтветНаДобавить}
              ?Кнопка {СписокВОтветНаУдалить}
              ?Кнопка {ОдинВОтветНа}
          
          #Контрагент {ГруппаКонтрагент}
            ?ПолеВвода {ВидОбращения}
            
            %{ГруппаКонтрагентМного}
              #Группа только контрагент
                ?ПолеВвода {Контрагент}
              %{ГруппаИндексыСПАРКРиски2} @СветофорКрасный {ДекорацияИндексыСПАРКРискиСтрока2КартинкаКр}; @СветофорОражевый {ДекорацияИндексыСПАРКРискиСтрока2КартинкаОранж}; @СветофорЗеленый {ДекорацияИндексыСПАРКРискиСтрока2КартинкаЗел}
              ?Кнопка {МногоКонтрагентов}
            
            %{ГруппаИндексыСПАРКРиски} ?Надпись {ДекорацияИндексыСПАРКРиски}; @ДлительнаяОперация16 {КартинкаОжиданиеЗагрузкиИндексовСПАРКРиски}
            
            ?ПолеВвода {КонтактноеЛицо}
            ?ПолеВвода {ПодписалОтКонтрагента}
            
            %{ГруппаИсходящийНомер} ?ПолеВвода {ИсходящаяДата}; ?ПолеВвода {ИсходящийНомер}
            
            %{ГруппаСвязиОбращений}
              #Группа повторное
                ?ПолеФлажок {Повторное}
                ?ПолеФлажок {Дубликат}
              #Группа дубликат
                ?ПолеВвода {ПервичноеОбращение}
                ?ПолеВвода {ОсновноеОбращение}
            
            %{ГруппаВходящийНомер} ?ПолеВвода {ВходящийНомер}; ?ПолеВвода {ВходящаяДата}
            
            %{ГруппаОтправленДата} ?ПолеФлажок {Отправлен}; ?ПолеВвода {ДатаОтправки}
            
            ?ПолеВвода {СпособОтправки}
            ?Надпись {ДекорацияКому}
          
          #Стороны {ГруппаСтороны}
            %{ГруппаДекарацияИПанель} ?Надпись {ДекорацияСтороны}; ?КоманднаяПанель {КоманднаяПанельСтороны}
            
            | СтороныКонтактноеЛицо |
            | СтороныНаименование |
            | СтороныПодписал |
            | Дата |
            | СтороныКомментарий |
            | СтороныУстановил |
          
          #Получатель {ГруппаПолучатель}
            %{ГруппаПолучательИЗаголовок} ?Надпись {ДекорацияПолучатель}; ?ПолеВвода {Получатель}
            
            %{ГруппаАвансовыйОтчет}
              %{ГруппаАвансовыйОтчетНеПредоставлен} ?Надпись {ДекорацияАвансовыйОтчетНеПредоставлен}; ?Надпись {ДекорацияАвансовыйОтчетНеПредоставленСсылка}; ?ПолеВвода {СрокПредоставленияАвансовогоОтчета}
              %{ГруппаАвансовыйОтчетПредоставлен} ?Надпись {ДекорацияАвансовыйОтчетПредоставлен}; ?Надпись {ДекорацияАвансовыйОтчетПредоставленСсылка}
              %{ГруппаАвансовыйОтчетУказан} ?Надпись {ДекорацияАвансовыйОтчетУказан}; ?ПолеВвода {АвансовыйОтчет}
              %{ГруппаАвансовыйОтчетНеТребуется} ?Надпись {ДекорацияАвансовыйОтчетНеТребуется}; ?Надпись {ДекорацияАвансовыйОтчетНеТребуетсяСсылка}
          
          ?ПолеНадписи {КраткиеСведенияОСвязях}
          ?ПолеВвода {КомментарийРеквизит}
          ?ПолеНадписи {ОригиналПолученТекст}
        ###{ГруппаПраво}
          #Группа номер
            #Группа рег номер
              ?ПолеВвода {РегистрационныйНомер}
              ?ПолеВвода {ДатаРегистрации}
            
            %{ГруппаВремНомер} ?ПолеВвода {ВременныйНомер}
          
          #Реквизиты {ГруппаРеквизиты}
            %{ГруппаПапка} ?ПолеВвода {Папка}
            
            %{ГруппаСрокИсполнения} ?ПолеВвода {СрокИсполнения}; ?Надпись {НадписьРабочихДней}
            
            %{ГруппаСумма} ?ПолеВвода {Сумма}; ?ПолеВвода {Сумма1}; ?ПолеВвода {Валюта}
            
            %{ГруппаСуммаНДС} ?ПолеВвода {СуммаНДС}
            
            #{ГруппаСуммаНДССтатьиДДС}
              %{ГруппаСтатьиДДС}
                //{СтраницыСуммаВернаНеверна}
                  /{СтраницаСуммаВерна}
                    //{СтраницыСтатьиДДС}
                      /{СтраницаСтатьяДДС}
                        ?Надпись {ЗаголовокСтатьяДДС}
                      /{СтраницаСтатьиДДС}
                        ?Надпись {ЗаголовокСтатьиДДС}
                    
                    ?ПолеВвода {ПредставлениеСтатейДДС}
                  /Страница сумма неверна
                    ?Надпись {ДекорацияСуммаНеверна}
                    ?Надпись {ДекорацияИзменитьСумму}
            
            ?ПолеВвода {СрокДействияСтрока}
            
            %{ГруппаОтменен}
              ?ПолеФлажок {НеДействует}
              ?Надпись {ДекорацияГотовитсяКОтмене}
              ?ПолеНадписи {ДатаОкончанияДействия}
              ?ПолеВвода {НеДействуетВСоответствииСтрока}
              ?ПолеВвода {НеДействуетВСоответствии}
            
            ?Надпись {ДелаетНедействующимиСтрока}
            ?ПолеВвода {ГрифДоступа}
            ?ПолеВвода {ВопросДеятельности}
            ?ПолеВвода {Проект}
            ?ПолеВвода {СостояниеТекст}
            ?ПолеНадписи {СостояниеЭДО}
            ?ПолеВвода {Адресат}
            ?ПолеВвода {Подразделение}
            ?ПолеВвода {Подготовил}
            ?ПолеВвода {Ответственный}
          
          #Хранение {ГруппаХранение}
            ?ПолеВвода {СоставСтрока}
            ?ПолеВвода {ФормаДокумента}
            ?ПолеВвода {НоменклатураДел}
            ?ПолеВвода {ДелоТекст}
            ?ПолеВвода {МестоХранения}
            ?ПолеВвода {ОтветственныйЗаХранение}
            ?Надпись {ДекорацияХранение}
          
          %{ГруппаДобавитьФайл} ?Кнопка {ДобавитьФайл}
          
          ?Надпись {ДекорацияОтступ}
    /Контрагенты {ГруппаКонтрагенты}
      | Контрагент           ||
      | КонтрагентыКонтрагент |
      | Подписал |
      | Контакт |
      | Получатели исходящей корреспонденции                   ||
      | КонтрагентыДатаОтправки | Способ | Вх. номер | Вх. дата |
    /Состав комплекта {ГруппаСоставКомплекта}
      | СоставКомплектаКомментарий |
    /Файлы {СтраницаФайлы}
      //Группа списки файлов{ГруппаСпискиФайлов}
        /Группа список {ГруппаСписокСоздание}
          | АвторСоздание | РедактируетСоздание | Размер (Кб) | Отредактировал | Отредактирован |
          
          %{ГруппаНадписьОтсутствуетОригиналСоздание} @Предупреждение {КартинкаОтсутствуетОригиналСоздание}; ?Надпись {ДекорацияОтсутствуетОригиналСоздание}
        /Группа таблица
    /Товары и услуги {СтраницаТовары}
      ?КоманднаяПанель {КоманднаяПанельНоменклатура}
      
      %{ГруппаНоменклатура}
        | ТоварыНоменклатура | ТоварыКоличество | Ед. | ТоварыЦена | ТоварыСтавкаНДС | ТоварыСуммаНДС | ТоварыСумма |
        %{ВсяНоменклатура}
          #{ГруппаДобавитьНоменклатуру}
            ?Кнопка {ДобавитьНоменклатуру}
    /Вопросы {СтраницаВопросы}
      #Группа вопросы списком
        | Классификация | ВопросыРаздел | ВопросыТематика | ВопросыТема | ВопросыВопрос | Результат | ВопросыДокумент | ВопросыДатаОтвета | ВопросыОрганДляПередачи | ВопросыМнениеАвтораОРезультатах | ВопросыМнениеАвтораОМерах |
      
      %{ГруппаОдинВопрос}
        #Группа классификация
          #Группа вопрос и результаты
            %{ГруппаВопрос} ?ПолеВвода {КодВопроса}; ?Кнопка {НесколькоВопросов}
            
            ?ПолеВвода {РезультатРассмотрения}
            
            #Группа - Результат рассмотрение {ГруппаРезультат}
              ?ПолеВвода {ДатаОтвета}
              
              #Группа орган и сопроводительный документ
                ?ПолеВвода {ОрганДляПередачи}
                
                %{СопроводительныйДокмуент} ?ПолеВвода {СопроводительныйДокументСтрока}
              
              %{ГруппаОтветныйДокумент} ?ПолеВвода {ОтветныйДокументСтрока}
              
              #Группа мнение автора
                ?ПолеВвода {МнениеАвтораОРезультатах}
                ?ПолеВвода {МнениеАвтораОМерах}
      
      %{ГруппаВыгрузкаССТУ} ?ПолеФлажок {ГотовоКВыгрузкеССТУ}; ?Надпись {ДекорацияСостояниеССТУ}
    /МЭДО {ГруппаМЭДО}
      %{ГруппаОтправка} ?ПолеФлажок {ГотовКОтправкеМЭДО}; ?ПолеФлажок {ОтправленМЭДО}
      
      %{ГруппаДанныеДокументаМЭДО}
        #Группа вид, место
          ?ПолеВвода {ВидДокументаМЭДО}
          ?ПолеВвода {МестоСоставленияМЭДО}
        #Группа главный файл, состояние {ГруппаФайлСостояние}
          ?ПолеВвода {ГлавныйФайлМЭДО}
          ?ПолеВвода {ТекущееСостояниеМЭДО}
      
      | ИсторияСостоянийМЭДОПериод |
    /Обработка {СтраницаОбработка}
      %{ГруппаКнопкиЗапуска}
        ?Кнопка {ДействияОтправить}
        ?Кнопка {ДействияОстановить}
        %{ГруппаСостояниеОбработки} ?Надпись {ДекорацияОтступСостояния}; @undefined {ДекорацияСостояния}; ?Надпись {ДекорацияОписание}
        ?КоманднаяПанель {ГруппаДействияКомПанель}
        ?Надпись {ДекорацияОшибкаДействия}
        %{ГруппаВОчереди} @Входящий {ДекорацияКартинкаОчередь}; ?Надпись {ДекорацияИнфоВОчереди}
      
      | ДействияПредставление |
      | ДействияПредставлениеСотрудники |
      | ДействияСрокПредставление |
      | ДействияПредставлениеРезультата |
      | Комментарий |
      | Дата состояния |
      
      #Группа информация о прерывании обработки
        ?Надпись {ДействияНадписьПричинаПрерыванияОбработки}
        
        %{ГруппаПрервалОбработку} ?Надпись {ДействияНадписьПрервал}; ?Кнопка {РасшифроватьПрервавшегоОбработку}
      
      ?Кнопка {ЗадачиПоПриложению}
    /Свойства {ГруппаСвойства}
    /Дополнительно {ГруппаДополнительно}
      ?ПолеНадписи {СоздалТекст}
      ?ПолеВвода {Зарегистрировал}
      | ФизическоеЛицо |
    /Связи {ГруппаСвязи}
      ?КоманднаяПанель {КоманднаяПанельДеревоСвязей}
      
      %{ГруппаДеревоСвязейПредставлениеHTML}
        #{ГруппаДеревоСвязей}
          ?ПолеФлажок {ПоказыватьТолькоОригиналыВСвязях}
        #Группа представление HTMLВСвязях
          %{ГруппаПредпросмотрУрезанСвязи} @Предупреждение {ДекорацияИконкаУрезанСвязи}; ?Надпись {ДекорацияПредпросмотрУрезанСвязи}
          
          ?ПолеHTMLДокумента {СвязиПредставлениеHTML}
          ?Надпись {ДекорацияВыравнивающийБлок}
    /Переадресован {ГруппаПереадресация}
      ###От кого переадресован {ГруппаОтКогоПереадресовано}
        ?ПолеВвода {Переадресовавший}
        ?ПолеВвода {КонтактноеЛицоПереадресовавшего}
        
        %{ГруппаТребуетсяОтвет} ?ПолеФлажок {ТребуетсяОтветПереадресовавшему}; ?ПолеВвода {СрокОтветаПереадресовавшему}; ?Кнопка {ОтправитьОтветПереадресовавшему}
        
        ?ПолеВвода {ОтветПереадресовавшему}
      
      ###Кому переадресован {ГруппаКомуПереадресован}
        ?Кнопка {Переадресовать}
        ?ПолеВвода {Переадресат}
        ?ПолеВвода {КонтактноеЛицоПереадресата}
        ?ПолеВвода {ПереадресованДокументом}
    /ЭП {ГруппаЭП}
      | ТаблицаПодписейАвторПодписиИСтатус | ТаблицаПодписейДатаПодписиИКомментарий |
    /Категории
      %{ГруппаКатегории}
        | Выбранные категории |
      
      %{ГруппаСтатусы}
        //Группа авто категоризация{ГруппаАвтоКатегоризация}
          /{ГруппаАвтокатегоризацияВыполнена}
            @СостояниеОбменаДаннымиУспех {ДекорацияАКВыполненаКартинка}
            ?Надпись {ДекорацияАКВыполненаТекст}
          /{ГруппаАвтокатегоризацияНеВыполнена}
            @СостояниеОбменаДаннымиОшибка {ДекорацияАКНеВыполненаКартинка}
            ?Надпись {ДекорацияАКНеВыполненаТекст}
        //Группа проверка категорий{ГруппаПроверкаКатегорий}
          /Группа категории проверены
            @СостояниеОбменаДаннымиУспех {ДекорацияКатегорииПровереныКартинка}
            ?Надпись {ДекорацияКатегорииПровереныТекст}
          /Группа категории не проверены
            @СостояниеОбменаДаннымиОшибка {ДекорацияКатегорииНеПровереныКартинка}
            ?Надпись {ДекорацияКатегорииНеПровереныТекст}
    /Доступ {ГруппаДоступ}
      ?Надпись {ДекорацияЗапретРасширенияДоступа}
      ?Надпись {ДекорацияРГОбновлена}
      | РабочаяГруппаТаблицаИсточникОтображение |
      ?ПолеФлажок {ЗапретитьАвтоматическоеДобавлениеУчастниковРабочейГруппы}
      ?ПолеНадписи {РабочаяГруппаТекст}
      ?ПолеНадписи {РабочаяГруппаПодпись}
  #Группа инструкции
    ?ПолеHTMLДокумента {Инструкция}