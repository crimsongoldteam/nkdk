%{ГруппаРаспознаваниеДокумента}% Документ находится на распознавании. Доступен только для просмотра. {РаспознаваниеДокументаНадпись}

%{ГруппаПереданВАрхивИлиУничтожен}% @ИнформацияБЭД {ПереданВАрхивИлиУничтоженКартинка}; Документ уничтожен {ПереданВАрхивИлиУничтоженНадпись}

%{ГруппаПометкаУдаления}% @ИнформацияБЭД {ПометкаУдаленияКартинка}; Документ помечен на удаление {ПометкаУдаленияНадпись}

%{ГруппаНеРедактируется}
  @Предупреждение32 {ДекорацияЗагруженИзВнешнейСистемы}
  #Группа не редактируется описание
    ?ПолеНадписи {НеРедактируетсяОписание}

%{ГруппаКомПанели}% <{ФормаЗаписатьИЗакрыть}|{ФормаЗакрыть}|{ФормаЗаписать}|{Зарегистрировать}|{ОтправитьОбъекты}|{ПоделитьсяДокументомShareКомПанель}>; <{ФормаСправка}>

%{ГруппаЗадач}% Этот документ находится у вас на согласовании. {ДекорацияЗадач}; <Перейти к согласованию {ПерейтиКВыполнениюЗадачи}>

%{ГруппаПлашкаЭДО}% Документ ЭДО аннулирован {ДекорацияЭДО}

%{ГруппаДанные}
  %{МК_ГруппаПереключателиСтраниц}
    %{МК_ПереключателиПерваяСтрока}% <Обзор {МК_КнопкаСтраницаОбзор}>; <Реквизиты {МК_КнопкаСтраницаОсновное}>; <Файлы {МК_КнопкаСтраницаФайлы}>; <Участники {МК_КнопкаСтраницаКонтрагенты}>; <Обработка {МК_КнопкаСтраницаОбработка}>
    %{МК_ПереключателиВтораяСтрока}% <Категории {МК_КнопкаСтраницаКатегории}>; <ЭП {МК_КнопкаСтраницаЭП}>; <Доступ {МК_КнопкаСтраницаРабочаяГруппа}>
  //Страницы{ГруппаСтраницы}
    /Обзор
      %{ГруппаОбзорФайлы}
        #Группа файлы
          #{МК_ДеревоОбзора}
            %{МК_ДеревоОбзораКоманднаяПанель}% <{МК_СоздатьФайл}>; Документ и файлы {МК_ДеревоОбзораЗаголовок}; <{МК_ПоказатьСкрытьДеревоОбзора}>
          
          %{ДекорацияКоманды}% <Добавить {СоздатьФайл}|{Сканировать}|{ВставитьКартинкуИзБуфера}|{ДобавитьСканСМобильного}|{ОткрытьФайл}|{Редактировать}|{ЗакончитьРедактирование}|{Распознать}|{Освободить}|{ОбновитьИзФайлаНаДиске}|{Напечатать}|Открыть карточку {Изменить}|{Удалить}|{СохранитьКак}|{ФайлыЗаполнитьФайлДаннымиДокумента}|{ВставитьРегистрационныйШтампИШтрихкод}|{ФайлыРаспознать}|{ФайлыПоказыватьУдаленныеФайлы}|{Обновить}>
          
          
          %{ГруппаНадписьОтсутствуетОригинал}% @Предупреждение {КартинкаОтсутствуетОригинал}; В списке файлов отсутствует скан-копия оригинала документа. {ДекорацияОтсутствуетОригинал}
        #Группа представление HTML
          ;
          
          //Группа предпросмотр страницы{ГруппаПредпросмотрСтраницы}
            /{ГруппаHtml}
              %{ГруппаПредпросмотрУрезан}% @Предупреждение {ДекорацияИконкаУрезан}; Файл показан в сокращенном виде, т.к. содержит большой текст. Откройте файл для просмотра, чтобы увидеть полностью. {ДекорацияПредпросмотрУрезан}
              
              ?ПолеHTMLДокумента {ПредставлениеHTML}
              <>
            /{ГруппаPdf}
              ;
            /Группа ЭДО
              //Группа ЭДО страницы{ГруппаЭДОСтраницы}
                /Группа ЭДО табличный
                  ?ПолеТабличногоДокумента {ТабличныйДокументЭДО}
            /Автопротокол {ГруппаТаймлистАвтопротокол}
              ?ПолеHTMLДокумента {ТаймлистАвтопротоколHTML}
            /Распознанный текст {ГруппаРаспознанныйТекст}
              ?ПолеHTMLДокумента {РаспознанныйТекстHTML}
          
          %{ГруппаСостояния}
            ?ПолеРисунка {КартинкаВзаимодействие}
            ?ПолеРисунка {КартинкаЭП}
            ?ПолеРисунка {КартинкаКатегории}
            ?ПолеРисунка {КартинкаФорум}
            ?ПолеРисунка {КартинкаКонтроль}
            ?ПолеРисунка {КартинкаСостояниеДела}
            ?ПолеРисунка {КартинкаЭДО}
    /Реквизиты {ГруппаОсновные}
      %{ГруппаЭлемента}
        ###Группа лево
          {ВидИТематикаТекст}: __В
          
          #Группа наименование код
            {Заголовок}: 
          
          {Содержание}: 
          
          %{ГруппаПредметПерепискиНесколько}% {ПредметПереписки}: ; <{НесколькоПредметовПереписки}>
          
          %{ГруппаСписокПредметовПерепискиИКоманды}
            | Предметы переписки |
            #Групп команды списка предметов переписки
              <{СписокПредметовПерепискиДобавить}>
              <{СписокПредметовПерепискиУдалить}>
              <{ОдинПредметПереписки}>
          
          #Наша организация {ГруппаОрганизация}
            Декорация организация {ДекорацияОрганизация}
            {Организация}: 
            {АдресатВходящейКорреспонденции}: 
            Получен: {СпособПолучения}
            {УтверждениеТекст}: __В
            Подписан: __ВХ {ПодписьТекст}
          
          %{ГруппаВОтветНаНесколько}% {ВОтветНаСтрока}: __ВО; <{НесколькоВОтветНа}>
          
          %{ГруппаСписокВОтветНаИКоманды}
            | В ответ на | В ответ на |
            #Группа команды списка в ответ на
              <{СписокВОтветНаДобавить}>
              <{СписокВОтветНаУдалить}>
              <{ОдинВОтветНа}>
          
          #Контрагент {ГруппаКонтрагент}
            {ВидОбращения}: 
            
            %{ГруппаКонтрагентМного}
              #Группа только контрагент
                Контрагент: {Контрагент}
              %{ГруппаИндексыСПАРКРиски2}% @СветофорКрасный {ДекорацияИндексыСПАРКРискиСтрока2КартинкаКр}; @СветофорОражевый {ДекорацияИндексыСПАРКРискиСтрока2КартинкаОранж}; @СветофорЗеленый {ДекорацияИндексыСПАРКРискиСтрока2КартинкаЗел}
              <{МногоКонтрагентов}>
            
            %{ГруппаИндексыСПАРКРиски}% {ДекорацияИндексыСПАРКРиски}; @ДлительнаяОперация16 {КартинкаОжиданиеЗагрузкиИндексовСПАРКРиски}
            
            Контакт: {КонтактноеЛицо}
            Подписал: {ПодписалОтКонтрагента}
            
            %{ГруппаИсходящийНомер}% Исходящий от: {ИсходящаяДата}; №: {ИсходящийНомер}
            
            %{ГруппаСвязиОбращений}
              #Группа повторное
                Это повтор обращения:[]
                Это дубликат обращения:[]
              #Группа дубликат
                {ПервичноеОбращение}: 
                {ОсновноеОбращение}: 
            
            %{ГруппаВходящийНомер}% № получателя: {ВходящийНомер}; от: {ВходящаяДата}
            
            %{ГруппаОтправленДата}% Отправлен[]; Дата: {ДатаОтправки}
            
            Способ: __О {СпособОтправки}
            {ДекорацияКому}
          
          #Стороны {ГруппаСтороны}
            %{ГруппаДекарацияИПанель}% Стороны: {ДекорацияСтороны}; <>
            
            | СтороныКонтактноеЛицо |
            | СтороныНаименование |
            | СтороныПодписал |
            | Дата |
            | СтороныКомментарий |
            | СтороныУстановил |
          
          #Получатель {ГруппаПолучатель}
            %{ГруппаПолучательИЗаголовок}% Получатель: {ДекорацияПолучатель}; {Получатель}: 
            
            %{ГруппаАвансовыйОтчет}
              %{ГруппаАвансовыйОтчетНеПредоставлен}% Авансовый отчет: {ДекорацияАвансовыйОтчетНеПредоставлен}; не предоставлен {ДекорацияАвансовыйОтчетНеПредоставленСсылка}; Срок: {СрокПредоставленияАвансовогоОтчета}
              %{ГруппаАвансовыйОтчетПредоставлен}% Авансовый отчет: {ДекорацияАвансовыйОтчетПредоставлен}; предоставлен {ДекорацияАвансовыйОтчетПредоставленСсылка}
              %{ГруппаАвансовыйОтчетУказан}% Авансовый отчет: {ДекорацияАвансовыйОтчетУказан}; {АвансовыйОтчет}: 
              %{ГруппаАвансовыйОтчетНеТребуется}% Авансовый отчет: {ДекорацияАвансовыйОтчетНеТребуется}; не требуется {ДекорацияАвансовыйОтчетНеТребуетсяСсылка}
          
          ?ПолеНадписи {КраткиеСведенияОСвязях}
          {КомментарийРеквизит}: 
          ?ПолеНадписи {ОригиналПолученТекст}
        ###{ГруппаПраво}
          #Группа номер
            #Группа рег номер
              Рег. №: {РегистрационныйНомер}
              от: {ДатаРегистрации}
            
            %{ГруппаВремНомер}% Врем. №: {ВременныйНомер}
          
          #Реквизиты {ГруппаРеквизиты}
            %{ГруппаПапка}% {Папка}: 
            
            %{ГруппаСрокИсполнения}% Срок: {СрокИсполнения}; Надпись рабочих дней {НадписьРабочихДней}
            
            %{ГруппаСумма}% {Сумма}: ; {Сумма1}: ; {Валюта}: __О
            
            %{ГруппаСуммаНДС}% в т.ч. НДС: {СуммаНДС}
            
            #{ГруппаСуммаНДССтатьиДДС}
              %{ГруппаСтатьиДДС}
                //{СтраницыСуммаВернаНеверна}
                  /{СтраницаСуммаВерна}
                    //{СтраницыСтатьиДДС}
                      /{СтраницаСтатьяДДС}
                        Статья ДДС: {ЗаголовокСтатьяДДС}
                      /{СтраницаСтатьиДДС}
                        Статьи ДДС: {ЗаголовокСтатьиДДС}
                    
                    {ПредставлениеСтатейДДС}: __ВСХОД
                  /Страница сумма неверна
                    Сумма по статьям ДДС неверна. {ДекорацияСуммаНеверна}
                    Изменить... {ДекорацияИзменитьСумму}
            
            Срок действия: __В {СрокДействияСтрока}
            
            %{ГруппаОтменен}
              {НеДействует}
              Готовится к отмене документом: {ДекорацияГотовитсяКОтмене}
              ?ПолеНадписи {ДатаОкончанияДействия}
              {НеДействуетВСоответствииСтрока}: __ВО
              {НеДействуетВСоответствии}: 
            
            Делает недействующими {ДелаетНедействующимиСтрока}
            Гриф: {ГрифДоступа}
            Вопрос: {ВопросДеятельности}
            {Проект}: 
            {СостояниеТекст}: __В
            ?ПолеНадписи {СостояниеЭДО}
            {Адресат}: 
            {Подразделение}: 
            {Подготовил}: 
            {Ответственный}: 
          
          #Хранение {ГруппаХранение}
            {СоставСтрока}: __ВС
            {ФормаДокумента}: 
            Номенкл. дел: {НоменклатураДел}
            В дело: __ВО {ДелоТекст}
            {МестоХранения}: 
            Отв. за хранение: {ОтветственныйЗаХранение}
            {ДекорацияХранение}
          
          %Добавить файл {ГруппаДобавитьФайл}% <Добавить... {ДобавитьФайл}>
          
          {ДекорацияОтступ}
    /Контрагенты {ГруппаКонтрагенты}
      | Контрагент           ||
      | КонтрагентыКонтрагент |
