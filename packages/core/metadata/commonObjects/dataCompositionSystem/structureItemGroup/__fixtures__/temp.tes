<xs:complexType name="StructureItemGroup">
    <xs:annotation>
        <xs:documentation>Группировка</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
        <xs:extension base="tns:StructureItem">
            <xs:sequence>
                <xs:element name="use" type="xs:boolean" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Группировка используется.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="name" type="xs:string" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Имя группировки.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="groupItems" type="tns:GroupItems" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Поля, по которым осуществляется группировка</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="filter" type="tns:Filter" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Отбор, применяемый к записям, попадающим в группировку.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="order" type="tns:Order" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Порядок для упорядочивания групповых записей.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="selection" type="tns:Selection" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Поля, выводимые в группировке.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="conditionalAppearance" type="tns:ConditionalAppearance" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Условное оформление, применяемое в группировке.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="outputParameters" type="tns:GroupOutputParameterValues" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Использование зависит от свойства.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="item" type="tns:StructureItem" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation>Элементы структуры группировки.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="id" type="xs:string" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Идентификатор</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="viewMode" type="tns:DataCompositionSettingsItemViewMode" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Режим отображения</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="userSettingID" type="xs:string" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Идентификатор выделенной настройки</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="userSettingPresentation" type="xs:anyType" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Представление выделенной настройки</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="itemsViewMode" type="tns:DataCompositionSettingsItemViewMode" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Режим отображения структуры</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="itemsUserSettingID" type="xs:string" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Идентификатор выделенной настройки структуры</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="itemsUserSettingPresentation" type="xs:anyType" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Представление выделенной настройки структуры</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="groupState" type="tns:DataCompositionSettingsItemState" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Состояние группировки</xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="iID" type="xs:decimal" default="0" use="optional"/>
        </xs:extension>
    </xs:complexContent>
</xs:complexType>
<xs:complexType name="GroupOutputParameterValues">
    <xs:annotation>
        <xs:documentation>
            Параметры вывода группировки. Возможны следующие параметры:
            TotalsPlacement - итоги по строкам колонкам (TotalPlacement)
            GroupFieldsPlacement - размещение полей группировки (GroupFieldsPlacementType)
            GroupPlacement - тип размещения группировок (GroupPlacementType)
            AttributePlacement
            ResourcePlacement
            VerticalOverallsPlacement  - (TotalPlacement)
            ChartType (ТипДиаграммы) - тип диаграммы. Перечисление ТипДиаграммы.
            ChartType.BaseValue (ТипДиаграммы.БазовоеЗначение)– Базовое значение. Число.
            ChartType.HideBaseValue (ТипДиаграммы.ПропускатьБазовоеЗначение) - Пропускать точки с базовым значением. Булево.
            ChartType.LabelType (ТипДиаграммы.ВидПодписей) - Состав подписей. Перечисление ВидПодписейКДиаграмме (ChartLabelType).
            ChartType.AutoSeriesSeparation (ТипДиаграммы.АвтоРаздвижениеСерий) Режим раздвижения. Перечисление АвтоРаздвижениеСерий (AutoSeriesSeparation).
            ChartType.ShowDataTable (ТипДиаграммы.ОтображатьТаблицуДанных)- Отображать таблицу данных. Булево.
            ChartType.MaxValue (ТипДиаграммы.МаксимальноеЗначение) - Максимальное значение. Число.
            ChartType.MinValue (ТипДиаграммы.МинимальноеЗначение) - Минимальное значение. Число.
            ChartType.Outline (ТипДиаграммы.Окантовка) – Окантовка. Булево.
            ChartType.Gradient (ТипДиаграммы.Градиент) – Градиент. Булево.
            ChartType.Font(ТипДиаграммы.Шрифт) - Шрифт диаграммы. Шрифт
            ChartType.BackColor(ТипДиаграммы.ЦветФона) - Цвет фона диаграммы. Цвет.
            ChartType.BorderStyle(ТипДиаграммы.СтильЛинии) - стиль линии вокруг диаграммы. Линия.
            ChartType.LegendPlacement(ТипДиаграммы.РасположениеЛегенды) - расположение легенды в диаграммы. РасположениеЛегендыДиаграммыСистемыКомпоновкиДанных.
            ChartType.GaugeChartQualityBands(ТипДиаграммы.ПолосыИзмерительнойДиаграммы) - полосы для измерительной диаграммы. ПолосыИзмерительнойДиаграммы.
            ChartType.ResourcesPlacement(ТипДиаграммы.РасположениеРесурсов) - расположение ресурсов в диаграмме. РасположениеРесурсовВДиаграммеКомпоновкиДанных.
            TemplateType - тип макета
            FieldsTitleType - тип заголовков полей(DataCompositionFieldsTitleType)
            RecordsCount(КоличествоЗаписей) - количество записей, которое необходимо выводить в группировке
            RecordsPercent(ПроцентЗаписей) - процент записей, которое необходимо выводить в группировке
            ResourcesAutoPosition - авто позиция ресурсов (DataCompositionResourcesAutoPosition)
        </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
        <xs:extension base="dcscore:ParameterValues"/>
    </xs:complexContent>
</xs:complexType>
<xs:complexType name="StructureItemTable">
    <xs:annotation>
        <xs:documentation>Таблица</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
        <xs:extension base="tns:StructureItem">
            <xs:sequence>
                <xs:element name="use" type="xs:boolean" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Таблица используется</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="name" type="xs:string" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Имя таблицы</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="column" type="tns:TableGroup" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation>Колонки таблицы</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="row" type="tns:TableGroup" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation>Строки таблицы</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="selection" type="tns:Selection" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Выбранные поля. При выводе не используется.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="conditionalAppearance" type="tns:ConditionalAppearance" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Условное оформление, используемое в таблице.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="outputParameters" type="tns:TableOutputParameterValues" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Параметры вывода таблицы. Использование зависит от свойства.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="id" type="xs:string" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Идентификатор</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="viewMode" type="tns:DataCompositionSettingsItemViewMode" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Режим отображения</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="userSettingID" type="xs:string" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Идентификатор выделенной настройки</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="userSettingPresentation" type="xs:anyType" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Представление выделенной настройки</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="columnsViewMode" type="tns:DataCompositionSettingsItemViewMode" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Режим отображения колонок</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="columnsUserSettingID" type="xs:string" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Идентификатор выделенной настройки структуры колонок</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="columnsUserSettingPresentation" type="xs:anyType" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Представление выделенной настройки структуры колонок</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="rowsViewMode" type="tns:DataCompositionSettingsItemViewMode" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Режим отображения строк</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="rowsUserSettingID" type="xs:string" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Идентификатор выделенной настройки структуры строк</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="rowsUserSettingPresentation" type="xs:anyType" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Представление выделенной настройки структуры строк</xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="iID" type="xs:decimal" default="0" use="optional"/>
        </xs:extension>
    </xs:complexContent>
</xs:complexType>
<xs:complexType name="TableOutputParameterValues">
    <xs:annotation>
        <xs:documentation>
            Параметры вывода таблицы. Возможны следующие параметры:
            TotalsPlacement - итоги по строкам колонкам (TotalPlacement)
            GroupFieldsPlacement - размещение полей группировки (GroupFieldsPlacementType)
            GroupPlacement - тип размещения группировок (GroupPlacementType)
            AttributePlacement
            ResourcePlacement
            HorizontalOverallPlacement - (TotalPlacement)
            VerticalOverallPlacement - (TotalPlacement)
            FieldsTitleType - тип заголовков полей(DataCompositionFieldsTitleType)
            OutputTitle - выводить заголовок (DataCompositionTextOutputType)
            Title - заголовок (Строка)
        </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
        <xs:extension base="dcscore:ParameterValues"/>
    </xs:complexContent>
</xs:complexType>
<xs:complexType name="TableGroup">
    <xs:annotation>
        <xs:documentation>Группировка таблицы</xs:documentation>
    </xs:annotation>
    <xs:sequence>
        <xs:element name="use" type="xs:boolean" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Группировка используется.</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="name" type="xs:string" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Имя группировки.</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="groupItems" type="tns:GroupItems" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Поля, по которым осуществляется группировка</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="filter" type="tns:Filter" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Фильтр, применяемый к записям, попадающим в группировку.</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="order" type="tns:Order" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Упорядочивание записей группировки.</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="selection" type="tns:Selection" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Поля, выводимые в группировке.</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="conditionalAppearance" type="tns:ConditionalAppearance" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Условоное оформление, применяемое для группировки</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="outputParameters" type="tns:TableGroupOutputParameterValues" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Параметры вывода группировки. Использование зависит от свойства.</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="item" type="tns:TableGroup" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
                <xs:documentation>Элементы структуры группировки</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="id" type="xs:string" maxOccurs="1" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Идентификатор</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="viewMode" type="tns:DataCompositionSettingsItemViewMode" maxOccurs="1" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Режим отображения</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="userSettingID" type="xs:string" maxOccurs="1" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Идентификатор выделенной настройки</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="userSettingPresentation" type="xs:anyType" maxOccurs="1" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Представление выделенной настройки</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="itemsViewMode" type="tns:DataCompositionSettingsItemViewMode" maxOccurs="1" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Режим отображения структуры</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="itemsUserSettingID" type="xs:string" maxOccurs="1" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Идентификатор выделенной настройки структуры</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="itemsUserSettingPresentation" type="xs:anyType" maxOccurs="1" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Представление выделенной настройки структуры</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="groupState" type="tns:DataCompositionSettingsItemState" maxOccurs="1" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Состояние группировки</xs:documentation>
            </xs:annotation>
        </xs:element>
    </xs:sequence>
    <xs:attribute name="iID" type="xs:decimal" default="0" use="optional"/>
</xs:complexType>
<xs:complexType name="TableGroupOutputParameterValues">
    <xs:annotation>
        <xs:documentation>
            Параметры вывода группировки таблицы. Возможны следующие параметры:
            TotalsPlacement - итоги по строкам колонкам (TotalPlacement)
            GroupFieldsPlacement - размещение полей группировки (GroupFieldsPlacementType)
            GroupPlacement - тип размещения группировок (GroupPlacementType)
            AttributePlacement
            ResourcePlacement
            FieldsTitleType - тип заголовков полей(DataCompositionFieldsTitleType)
            RecordsCount(КоличествоЗаписей) - количество записей, которое необходимо выводить в группировке
            RecordsPercent(ПроцентЗаписей) - процент записей, которое необходимо выводить в группировке
            UseVariant(ВариантИспользования) - вариант использования
        </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
        <xs:extension base="dcscore:ParameterValues"/>
    </xs:complexContent>
</xs:complexType>
<xs:complexType name="StructureItemChart">
    <xs:annotation>
        <xs:documentation>Диаграмма</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
        <xs:extension base="tns:StructureItem">
            <xs:sequence>
                <xs:element name="use" type="xs:boolean" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Диаграмма используется</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="name" type="xs:string" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Имя диаграммы</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="point" type="tns:ChartGroup" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation>Точки диаграммы.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="series" type="tns:ChartGroup" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation>Серии диаграммы.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="selection" type="tns:Selection" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Задаются ресурсы, выводимые в диаграмму.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="conditionalAppearance" type="tns:ConditionalAppearance" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Условное оформление, используемое в диаграмме.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="outputParameters" type="tns:ChartOutputParameterValues" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Параметры вывода диаграммы.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="id" type="xs:string" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Идентификатор</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="viewMode" type="tns:DataCompositionSettingsItemViewMode" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Режим отображения</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="userSettingID" type="xs:string" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Идентификатор выделенной настройки</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="userSettingPresentation" type="xs:anyType" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Представление выделенной настройки</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="pointsViewMode" type="tns:DataCompositionSettingsItemViewMode" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Режим отображения структуры точек</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="pointsUserSettingID" type="xs:string" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Идентификатор выделенной настройки структуры точек</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="pointsUserSettingPresentation" type="xs:anyType" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Представление выделенной настройки структуры точек</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="seriesViewMode" type="tns:DataCompositionSettingsItemViewMode" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Режим отображения структуры серий</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="seriesUserSettingID" type="xs:string" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Идентификатор выделенной настройки структуры серий</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="seriesUserSettingPresentation" type="xs:anyType" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Представление выделенной настройки структуры серий</xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="iID" type="xs:decimal" default="0" use="optional"/>
        </xs:extension>
    </xs:complexContent>
</xs:complexType>
<xs:complexType name="ChartOutputParameterValues">
    <xs:annotation>
        <xs:documentation>
            Параметры вывода диаграммы. Возможны следующие параметры:
            ChartType (ТипДиаграммы) - тип диаграммы. Перечисление ТипДиаграммы.
            ChartType.BaseValue (ТипДиаграммы.БазовоеЗначение)– Базовое значение. Число.
            ChartType.HideBaseValue (ТипДиаграммы.ПропускатьБазовоеЗначение) - Пропускать точки с базовым значением. Булево.
            ChartType.LabelType (ТипДиаграммы.ВидПодписей) - Состав подписей. Перечисление ВидПодписейКДиаграмме (ChartLabelType).
            ChartType.AutoSeriesSeparation (ТипДиаграммы.АвтоРаздвижениеСерий) Режим раздвижения. Перечисление АвтоРаздвижениеСерий (AutoSeriesSeparation).
            ChartType.ShowDataTable (ТипДиаграммы.ОтображатьТаблицуДанных)- Отображать таблицу данных. Булево.
            ChartType.MaxValue (ТипДиаграммы.МаксимальноеЗначение) - Максимальное значение. Число.
            ChartType.MinValue (ТипДиаграммы.МинимальноеЗначение) - Минимальное значение. Число.
            ChartType.Outline (ТипДиаграммы.Окантовка) – Окантовка. Булево.
            ChartType.Gradient (ТипДиаграммы.Градиент) – Градиент. Булево.
            ChartType.Font(ТипДиаграммы.Шрифт) - Шрифт диаграммы. Шрифт
            ChartType.BackColor(ТипДиаграммы.ЦветФона) - Цвет фона диаграммы. Цвет.
            ChartType.BorderStyle(ТипДиаграммы.СтильЛинии) - стиль линии вокруг диаграммы. Линия.
            ChartType.LegendPlacement(ТипДиаграммы.РасположениеЛегенды) - расположение легенды в диаграммы. РасположениеЛегендыДиаграммыСистемыКомпоновкиДанных.
            ChartType.GaugeChartQualityBands(ТипДиаграммы.ПолосыИзмерительнойДиаграммы) - полосы для измерительной диаграммы. ПолосыИзмерительнойДиаграммы.
            ChartType.ResourcesPlacement(ТипДиаграммы.РасположениеРесурсов) - расположение ресурсов в диаграмме. РасположениеРесурсовВДиаграммеКомпоновкиДанных.
            OutputTitle - выводить заголовок (DataCompositionTextOutputType)
            Title - заголовок (Строка)
        </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
        <xs:extension base="dcscore:ParameterValues"/>
    </xs:complexContent>
</xs:complexType>
<xs:complexType name="ChartGroupOutputParameterValues">
    <xs:annotation>
        <xs:documentation>
            Параметры вывода группировки диаграммы. Возможны следующие параметры:
            RecordsCount(КоличествоЗаписей) - количество записей, которое необходимо выводить в группировке
            RecordsPercent(ПроцентЗаписей) - процент записей, которое необходимо выводить в группировке
        </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
        <xs:extension base="dcscore:ParameterValues"/>
    </xs:complexContent>
</xs:complexType>
<xs:complexType name="ChartGroup">
    <xs:annotation>
        <xs:documentation>Группировка диаграммы</xs:documentation>
    </xs:annotation>
    <xs:sequence>
        <xs:element name="use" type="xs:boolean" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Группировка диаграммы используется.</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="name" type="xs:string" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Имя группировки.</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="groupItems" type="tns:GroupItems" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Поля, по которым осуществляется группировка.</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="filter" type="tns:Filter" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Фильтр, применяемый к записям, попадающим в группировку.</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="order" type="tns:Order" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Упорядочивание группировки.</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="selection" type="tns:Selection" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Поля выводимые поля.</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="conditionalAppearance" type="tns:ConditionalAppearance" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Условное оформление, применяемое в группировке.</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="outputParameters" type="tns:ChartGroupOutputParameterValues" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Параметры вывода группировки диаграммы.</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="item" type="tns:ChartGroup" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
                <xs:documentation>Вложенная группировка.</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="id" type="xs:string" maxOccurs="1" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Идентификатор</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="viewMode" type="tns:DataCompositionSettingsItemViewMode" maxOccurs="1" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Режим отображения</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="userSettingID" type="xs:string" maxOccurs="1" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Идентификатор выделенной настройки</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="userSettingPresentation" type="xs:anyType" maxOccurs="1" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Представление выделенной настройки</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="itemsViewMode" type="tns:DataCompositionSettingsItemViewMode" maxOccurs="1" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Режим отображения структуры</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="itemsUserSettingID" type="xs:string" maxOccurs="1" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Идентификатор выделенной настройки структуры</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="itemsUserSettingPresentation" type="xs:anyType" maxOccurs="1" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Представление выделенной настройки структуры</xs:documentation>
            </xs:annotation>
        </xs:element>
        <xs:element name="groupState" type="tns:DataCompositionSettingsItemState" maxOccurs="1" minOccurs="0">
            <xs:annotation>
                <xs:documentation>Состояние группировки</xs:documentation>
            </xs:annotation>
        </xs:element>
    </xs:sequence>
    <xs:attribute name="iID" type="xs:decimal" default="0" use="optional"/>
</xs:complexType>
<xs:complexType name="StructureItemNestedObject">
    <xs:annotation>
        <xs:documentation>Вложенный объект настройки</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
        <xs:extension base="tns:StructureItem">
            <xs:sequence>
                <xs:element name="use" type="xs:boolean" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Вложенный отчет используется</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="name" type="xs:string" maxOccurs="1" minOccurs="0"></xs:element>
                <xs:element name="objectID" type="xs:string">
                    <xs:annotation>
                        <xs:documentation>Идентификатор объекта настройки.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="settings" type="tns:Settings">
                    <xs:annotation>
                        <xs:documentation>Настройки вложенного объекта.</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="id" type="xs:string" maxOccurs="1" minOccurs="0"></xs:element>
                <xs:element name="viewMode" type="tns:DataCompositionSettingsItemViewMode" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Режим отображения</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="userSettingID" type="xs:string" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Идентификатор выделенной настройки</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="userSettingPresentation" type="xs:anyType" maxOccurs="1" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>Представление выделенной настройки</xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="iID" type="xs:decimal" default="0" use="optional"/>
        </xs:extension>
    </xs:complexContent>
</xs:complexType>
<xs:complexType name="GroupItems">
    <xs:annotation>
        <xs:documentation>Элементы группировки</xs:documentation>
    </xs:annotation>
    <xs:sequence>
        <xs:element name="item" type="tns:GroupItem" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
                <xs:documentation>Поле группировки</xs:documentation>
            </xs:annotation>
        </xs:element>
    </xs:sequence>
</xs:complexType>
<xs:complexType name="GroupItemField">
    <xs:annotation>
        <xs:documentation>Групповое поле</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
        <xs:extension base="tns:GroupItem">
            <xs:sequence>
                <xs:element name="use" type="xs:boolean"
                    minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>
                            Поле используется для группировки.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="field" type="dcscore:Field">
                    <xs:annotation>
                        <xs:documentation>
                            Путь к данным поля, по которому
                            осуществляется группировка.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="groupType"
                    type="dcscore:DataCompositionGroupType" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>
                            Тип группировки
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="periodAdditionType"
                    type="dcscore:DataCompositionPeriodAdditionType"
                    minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>
                            Тип дополнения
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="periodAdditionBegin"
                    type="xs:anyType" minOccurs="0" nillable="true">
                    <xs:annotation>
                        <xs:documentation>
                            Начальная дата периода. Может содержать
                            константное значение, липо значение -
                            поле.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="periodAdditionEnd"
                    type="xs:anyType" minOccurs="0" nillable="true">
                    <xs:annotation>
                        <xs:documentation>
                            Конечная дата периода. Может содержать
                            константное значение, липо значение -
                            поле.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="iID" type="xs:decimal" default="0" use="optional"/>
        </xs:extension>
    </xs:complexContent>
</xs:complexType>
<xs:complexType name="GroupItemAuto">
    <xs:annotation>
        <xs:documentation>Авто групповое поле</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
        <xs:extension base="tns:GroupItem">
            <xs:sequence>
                <xs:element name="use" type="xs:boolean"
                    minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>
                            Поле используется для группировки.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="iID" type="xs:decimal" default="0" use="optional"/>
        </xs:extension>
    </xs:complexContent>
</xs:complexType>