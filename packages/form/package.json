{
  "name": "@nakidka/core",
  "version": "1.0.0",
  "description": "Ядро библиотеки Nakidka для работы с метаданными и XML",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": {
      "import": "./index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "prepare": "ts-patch install && typia patch"
  },
  "dependencies": {
    "antd": "^6.0.1",
    "change-case": "^5.4.4",
    "chevrotain": "^11.0.3",
    "date-fns": "^4.1.0",
