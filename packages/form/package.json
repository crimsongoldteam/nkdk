    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "uuid": "^13.0.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@ryoppippi/unplugin-typia": "^2.6.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^27.2.0",
    "ts-patch": "^3.3.0",
    "typescript": "~5.9.3",
    "typia": "^10.1.0",
    "vitest": "^4.0.15"
