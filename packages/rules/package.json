{
  "name": "@nkdk/rules",
  "version": "0.0.3",
  "private": true,
  "description": "Ядро библиотеки NKDK для работы с метаданными и XML",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": {
      "import": "./index.ts"
    },
    "./workers/generic": "./metadata/composition/workers/generic.ts",
    "./workers/prepared-yaml": "./metadata/composition/workers/preparedYamlProject.ts",
    "./workers/import": "./metadata/composition/workers/importFromXml.ts",
    "./workers/sync": "./metadata/composition/workers/fullSyncToXml.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node ../../scripts/run-test-duration-check.mjs -- --no-isolate --project unit --project bundle-contract --project core-metadata --sequence.shuffle && pnpm run test:native && pnpm run test:integration",
    "test:native": "vitest run --no-isolate --project native-lmdb && vitest run --no-isolate --project native-lmdb-integration",
    "test:integration": "node ../../scripts/run-test-duration-check.mjs --integration -- --no-isolate --project integration --sequence.shuffle",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "benchmark:configuration-index": "tsx scripts/benchmark-configuration-index.mjs",
    "measure:project-state-binary": "tsx scripts/measure-binary-project-state.ts",
    "measure:validation-schemas": "tsx --expose-gc scripts/measure-validation-schemas.mjs",
    "measure:validation-workers": "node scripts/measure-validation-workers.mjs"
  },
  "dependencies": {
    "@nkdk/runtime": "workspace:*",
    "@node-rs/xxhash": "^1.7.6",
    "@zip.js/zip.js": "^2.8.34",
    "date-fns": "^4.4.0",
    "fast-xml-parser": "^5.10.1",
    "js-yaml": "^5.2.2",
    "lmdb": "^3.5.6",
    "p-limit": "^7.3.1",
    "piscina": "^5.3.0",
    "saxes": "^6.0.0",
    "structurae": "4.0.2",
    "typebox": "1.3.11",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "~7.0.0",
    "vitest": "^4.1.10"
  }
}
