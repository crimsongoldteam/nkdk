{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2025",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2025"],
    "rootDir": ".",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"],
    "paths": {
      "@nkdk/rules": ["./packages/rules/index.ts"],
      "@nkdk/platform": ["./packages/platform/index.ts"]
    }
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "resolveFullExtension": ".js"
  },
  "include": [
    "packages/rules/index.ts",
    "packages/rules/helpers/**/*.ts",
    "packages/rules/metadata/**/*.ts",
    "packages/rules/yaml/**/*.ts",
    "packages/mcp/src/**/*.ts",
    "packages/platform/index.ts",
    "packages/platform/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/__fixtures__/**",
    "**/tests/**"
  ]
}
