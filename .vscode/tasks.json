{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start dev server",
      "type": "shell",
      "command": "source ~/.zshrc 2>/dev/null; source ~/.zprofile 2>/dev/null; pnpm dev",
      "isBackground": true,
      "options": { "shell": { "executable": "/bin/zsh", "args": ["-c"] } },
      "problemMatcher": {
        "pattern": { "regexp": "^$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Local:.*http://localhost:3000.*"
        }
      }
    },
    {
      "label": "format all metadata files",
      "type": "shell",
      "command": "sh ${workspaceFolder}/tasks/format-metadata.sh",
      "problemMatcher": "$tsc"
    },
    {
      "label": "compile extension",
      "type": "shell",
      "command": "source ~/.zshrc 2>/dev/null; source ~/.zprofile 2>/dev/null; cd extension && pnpm run compile",
      "options": { "shell": { "executable": "/bin/zsh", "args": ["-c"] } },
      "problemMatcher": "$tsc",
      "group": { "kind": "build", "isDefault": false }
    },
    {
      "label": "build extension",
      "type": "shell",
      "command": "source ~/.zshrc 2>/dev/null; source ~/.zprofile 2>/dev/null; cd packages/extension && pnpm run build",
      "options": { "shell": { "executable": "/bin/zsh", "args": ["-c"] } },
      "problemMatcher": "$tsc",
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
