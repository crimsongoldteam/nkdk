// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "compile"],
      "problemMatcher": "$tsc",
      "group": {
        "kind": "build"
      },
      "label": "pnpm: compile"
    },
    {
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "watch"],
      "problemMatcher": "$tsc",
      "group": {
        "kind": "build"
      },
      "label": "pnpm: watch",
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
