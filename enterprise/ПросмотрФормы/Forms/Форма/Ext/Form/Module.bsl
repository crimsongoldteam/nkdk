#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура HTMLДокументПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	Событие = ДанныеСобытия.Event.eventData1C;
	
	Если Событие = Неопределено ИЛИ ТипЗнч(Событие) = Тип("Число") Тогда
		Возврат;
	КонецЕсли;
	Отступ = 2;
	JSON = Событие.data;
	JSON = Сред(JSON, Отступ, СтрДлина(JSON) - Отступ);
	JSON = СтрЗаменить(JSON, "\", "");
	ОбновитьФорму(JSON);
КонецПроцедуры

