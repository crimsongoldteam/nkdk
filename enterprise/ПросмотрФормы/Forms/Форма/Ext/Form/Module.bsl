// Кэш элементов и реквизитов выведенных ранее на форму.
// Структура
//   Реквизиты - Соответствие - реквизиты формы (ключ - полное имя реквизита, значение - значение реквизита)
//   Элементы - Массив - элементы формы
&НаКлиенте
Перем Кэш;

// Массив игнорируемых свойств при сравнении значений элементов формы.
// Массив строк.
&НаКлиенте
Перем мМассивИгнорируемыхСвойств;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтотОбъект.HTMLДокумент = "http://127.0.0.1:3456";
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Кэш = Новый Структура("Реквизиты, Элементы", Новый Соответствие, Новый Массив);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура HTMLДокументПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	Событие = ДанныеСобытия.Event.eventData1C;
	
	Если Событие = Неопределено ИЛИ ТипЗнч(Событие) = Тип("Число") Тогда
		Возврат;
	КонецЕсли;
	Отступ = 2;
	JSON = Событие.data;
	JSON = Сред(JSON, Отступ, СтрДлина(JSON) - Отступ);
	JSON = СтрЗаменить(JSON, "\", "");
	ОбновитьФормуНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обновляет форму на сервере: передаёт объект обработки и текущий JSON в метод Построить.
//
&НаСервере
Процедура ОбновитьФормуНаСервере()
	//ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	//ОбработкаОбъект.Построить(ЭтотОбъект, Элементы.ГруппаПросмотр, JSON, Кэш);
КонецПроцедуры

// Обновляет форму по данным JSON. Преобразует JSON в структуру и вызывает обновление на сервере.
//
// Параметры:
//  JSON - Строка - JSON-строка с данными формы
//
&НаКлиенте
Процедура ОбновитьФорму(JSON)
	СтруктураФормы = JSONВСтруктуру(JSON);
	Если СтруктураФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОбновитьФормуНаСервере();
КонецПроцедуры

// Преобразует JSON-строку в структуру.
//
// Параметры:
//  СтрокаJSON - Строка - JSON-строка для преобразования
//
// Возвращаемое значение:
//  Структура, Неопределено - преобразованная структура; Неопределено при ошибке парсинга
//
&НаКлиенте
Функция JSONВСтруктуру(СтрокаJSON)
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Попытка
		Результат = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		ЗарегистрироватьОшибку(НСтр("ru = 'Ошибка чтения JSON'"), ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
	ЧтениеJSON.Закрыть();
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция JSONВСтруктуруНаСервере(СтрокаJSON)
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Результат = ПрочитатьJSON(ЧтениеJSON);
	
	ЧтениеJSON.Закрыть();
	Возврат Результат;
КонецФункции

// Определяет, нужна ли передача изменений формы на сервер (есть удаляемые или добавляемые реквизиты).
//
// Параметры:
//  СтруктураИзмененияФормы - Структура - структура с полями УдаляемыеРеквизиты, ДобавляемыеРеквизиты
//
// Возвращаемое значение:
//  Булево - Истина, если есть изменения для передачи на сервер
//
&НаКлиенте
Функция ТребуетсяПередачаНаСервер(СтруктураИзмененияФормы)
	Возврат СтруктураИзмененияФормы.УдаляемыеРеквизиты.Количество() > 0
	ИЛИ СтруктураИзмененияФормы.ДобавляемыеРеквизиты.Количество() > 0
	ИЛИ СтруктураИзмененияФормы.ИзменяемыеРеквизиты.Количество() > 0;
КонецФункции

// Вычисляет изменения формы для обновления: удаляемые/добавляемые реквизиты и элементы, перемещения.
//
// Параметры:
//  СтруктураФормы - Структура - текущая структура формы (в т.ч. Prefix, Attributes, Elements)
//
// Возвращаемое значение:
//  Структура - поля: УдаляемыеРеквизиты (Массив), ДобавляемыеРеквизиты (Соответствие),
//  УдаляемыеЭлементы (Массив), ДобавляемыеЭлементы (Массив), ПеремещаемыеЭлементы (Массив),
//  СоответствиеЭлементов (Соответствие)
//
&НаКлиенте
Функция ПолучитьИзмененияФормыДляОбновления(СтруктураФормы)
	КэшПоИдентификатору = СоздатьПолучитьКэш(СтруктураФормы.Prefix);
	
	Результат = Новый Структура();
	Результат.Вставить("УдаляемыеРеквизиты", Новый Массив);
	Результат.Вставить("ДобавляемыеРеквизиты", Новый Массив);
	Результат.Вставить("ИзменяемыеРеквизиты", Новый Массив);
	
	Результат.Вставить("УдаляемыеЭлементы", Новый Массив);
	Результат.Вставить("ДобавляемыеЭлементы", Новый Массив);
	Результат.Вставить("ПеремещаемыеЭлементы", Новый Массив);
	Результат.Вставить("ИзменяемыеЭлементы", Новый Соответствие);
	
	ИзмененияРеквизитов = ПолучитьИзмененияРеквизитов(КэшПоИдентификатору.Реквизиты, СтруктураФормы.Attributes);
	Результат.УдаляемыеРеквизиты = ИзмененияРеквизитов.УдаляемыеРеквизиты;
	Результат.ДобавляемыеРеквизиты = ИзмененияРеквизитов.ДобавляемыеРеквизиты;
	Результат.ИзменяемыеРеквизиты = ИзмененияРеквизитов.ИзменяемыеРеквизиты;
	
	ЭлементыКэша = Новый Массив;
	Если КэшПоИдентификатору.Свойство("Элементы") Тогда
		ЭлементыКэша = КэшПоИдентификатору.Элементы;
	КонецЕсли;
	ЭлементыФормы = ПолучитьДочерниеЭлементы(СтруктураФормы);
	Если ЭлементыФормы = Неопределено Тогда
		ЭлементыФормы = Новый Массив;
	КонецЕсли;
	
	ИзмененияЭлементов = ПолучитьИзмененияЭлементов(ЭлементыКэша, ЭлементыФормы);
	Результат.УдаляемыеЭлементы = ИзмененияЭлементов.УдаляемыеЭлементы;
	Результат.ДобавляемыеЭлементы = ИзмененияЭлементов.ДобавляемыеЭлементы;
	Результат.ПеремещаемыеЭлементы = ИзмененияЭлементов.ПеремещаемыеЭлементы;
	Результат.ИзменяемыеЭлементы = ИзмененияЭлементов.ИзменяемыеЭлементы;
	
	Возврат Результат;
КонецФункции

#Область ИзменениеРеквизитов

// Вычисляет изменения реквизитов формы: удаляемые и добавляемые реквизиты.
//
// Параметры:
//  РеквизитыКэша - Соответствие - реквизиты из кэша (ключ - имя реквизита)
//  РеквизитыФормы - Массив - текущие реквизиты формы (элементы с полем Name)
//
// Возвращаемое значение:
//  Структура - поля: УдаляемыеРеквизиты (Массив), ДобавляемыеРеквизиты (Соответствие)
//
&НаКлиенте
Функция ПолучитьИзмененияРеквизитов(РеквизитыКэша, РеквизитыФормы)
	Результат = Новый Структура();
	Результат.Вставить("УдаляемыеРеквизиты", Новый Массив);
	Результат.Вставить("ДобавляемыеРеквизиты", Новый Массив);
	Результат.Вставить("ИзменяемыеРеквизиты", Новый Массив);
	
	СоответствиеРеквизитовКэша = Новый Соответствие;
	Для Каждого РеквизитКэша Из РеквизитыКэша Цикл
		СоответствиеРеквизитовКэша.Вставить(ПолучитьПолноеИмяРеквизита(РеквизитКэша), РеквизитКэша);
	КонецЦикла;
	
	НеиспользуемыеРеквизиты = Новый Соответствие();
	Для Каждого РеквизитКэша Из РеквизитыКэша Цикл
		НеиспользуемыеРеквизиты.Вставить(ПолучитьПолноеИмяРеквизита(РеквизитКэша), РеквизитКэша);
	КонецЦикла;
	
	Для Каждого Реквизит Из РеквизитыФормы Цикл
		ПолноеИмяРеквизита = ПолучитьПолноеИмяРеквизита(Реквизит);
		
		НеиспользуемыеРеквизиты.Удалить(ПолноеИмяРеквизита);
		
		РеквизитКэша = СоответствиеРеквизитовКэша.Получить(ПолноеИмяРеквизита);
		
		Если РеквизитКэша = Неопределено Тогда
			Результат.ДобавляемыеРеквизиты.Добавить(Реквизит);
			Продолжить;
		КонецЕсли;
		
		ИзмененияРеквизита = ПолучитьИзмененияРеквизита(Реквизит, РеквизитКэша);
		Если ИзмененияРеквизита = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Результат.ИзменяемыеРеквизиты.Добавить(ИзмененияРеквизита);
	КонецЦикла;
	
	// Удаление таблиц
	МассивРеквизитовПервогоУровня = Новый Массив;
	Для Каждого НеиспользуемыйРеквизит Из НеиспользуемыеРеквизиты Цикл
		Если НеиспользуемыйРеквизит.Значение.Свойство("Path") Тогда
			Продолжить;
		КонецЕсли;
		
		Результат.УдаляемыеРеквизиты.Добавить(НеиспользуемыйРеквизит.Значение);
		МассивРеквизитовПервогоУровня.Добавить(НеиспользуемыйРеквизит.Ключ);
	КонецЦикла;
	
	// Удаление реквизитов таблиц
	Для Каждого НеиспользуемыйРеквизит Из НеиспользуемыеРеквизиты Цикл
		Если НЕ НеиспользуемыйРеквизит.Значение.Свойство("Path") Тогда
			Продолжить;
		КонецЕсли;
		
		Если МассивРеквизитовПервогоУровня.Найти(НеиспользуемыйРеквизит.Значение.Path) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Результат.УдаляемыеРеквизиты.Добавить(НеиспользуемыйРеквизит.Значение);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Возвращает полное имя реквизита (с учетом Path).
//
// Параметры:
//  Реквизит - Структура - текущее значение реквизита (поля Name, Path)
//
// Возвращаемое значение:
//  Строка - полное имя реквизита
//
&НаКлиенте
Функция ПолучитьПолноеИмяРеквизита(Реквизит)
	Возврат ?(НЕ Реквизит.Свойство("Path"), "", Реквизит.Path + ".") + Реквизит.Name;
КонецФункции

#КонецОбласти


#Область ИзмененияЭлементов

// Сравнивает кэш элементов с текущими элементами формы и возвращает добавленные, удалённые и перемещённые.
//
// Параметры:
//  ЭлементыКэша - Массив - элементы из кэша (дерево элементов, узлы - структуры name, childItems)
//  ЭлементыФормы - Массив - текущие элементы формы (дерево, узлы - структуры name, childItems)
//
// Возвращаемое значение:
//  Структура - поля: ДобавляемыеЭлементы (Массив), УдаляемыеЭлементы (Массив),
//  ПеремещаемыеЭлементы (Массив), СоответствиеЭлементов (Соответствие), ИзмененныеСвойства (Соответствие)
//
&НаКлиенте
Функция ПолучитьИзмененияЭлементов(ЭлементыКэша, ЭлементыФормы)
	// 1. Плоская индексация
	ИндексЭлементыКэша = Новый Соответствие;
	Для Каждого УзелКорень Из ЭлементыКэша Цикл
		ИндексироватьДерево(УзелКорень, Неопределено, ИндексЭлементыКэша);
	КонецЦикла;
	
	ИндексЭлементыФормы = Новый Соответствие;
	Для Каждого УзелКорень Из ЭлементыФормы Цикл
		ИндексироватьДерево(УзелКорень, Неопределено, ИндексЭлементыФормы);
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("ДобавляемыеЭлементы", Новый Массив);
	Результат.Вставить("УдаляемыеЭлементы", Новый Массив);
	Результат.Вставить("ПеремещаемыеЭлементы", Новый Массив);
	Результат.Вставить("ИзменяемыеЭлементы", Новый Соответствие);
	
	// 2. Добавленные и Удаленные
	Для Каждого КвИзНового Из ИндексЭлементыФормы Цикл
		ЭлементФормы = КвИзНового.Значение.Элемент;
		ИмяРодителя = КвИзНового.Значение.ИмяРодителя;
		Если ИндексЭлементыКэша[КвИзНового.Ключ] = Неопределено Тогда
			СтруктураДобавляемогоЭлемента = Новый Структура;
			СтруктураДобавляемогоЭлемента.Вставить("Name", КвИзНового.Ключ);
			СтруктураДобавляемогоЭлемента.Вставить("ElementType", ЭлементФормы.ElementType);
			Если ИмяРодителя <> Неопределено Тогда
				СтруктураДобавляемогоЭлемента.Вставить("ParentName", ИмяРодителя);
			КонецЕсли;
			
			Результат.ДобавляемыеЭлементы.Добавить(СтруктураДобавляемогоЭлемента);
			
			ДобавитьИзменяемыеЭлементы(
				Результат.ИзменяемыеЭлементы,
				Неопределено,
				ЭлементФормы);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого КвИзСтарого Из ИндексЭлементыКэша Цикл
		Если ИндексЭлементыФормы[КвИзСтарого.Ключ] = Неопределено Тогда
			Результат.УдаляемыеЭлементы.Добавить(КвИзСтарого.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	// 3. Изменяемые свойства: рекурсивно по дереву (включая дочерние)
	Для Каждого УзелКорень Из ЭлементыФормы Цикл
		ОбновитьИзменяемыеЭлементыДерева(УзелКорень, ИндексЭлементыКэша, Результат.ИзменяемыеЭлементы);
	КонецЦикла;
	
	// 4. Перемещения: по каждому родителю через LIS
	ЗаполнитьПеремещаемыеЭлементы(ИндексЭлементыФормы, ИндексЭлементыКэша, Результат.ПеремещаемыеЭлементы);
	
	Возврат Результат;
КонецФункции

// Заполняет массив перемещаемых элементов: для каждого родителя из ДанныеНового
// анализирует порядок дочерних через LIS и добавляет записи о перемещениях.
//
// Параметры:
//  ДанныеНового - Соответствие - индексация нового дерева (имя - Структура с полем Ссылка)
//  ДанныеСтарого - Соответствие - индексация старого дерева
//  ПеремещаемыеЭлементы - Массив - массив для накопления перемещаемых элементов
//
&НаКлиенте
Процедура ЗаполнитьПеремещаемыеЭлементы(ДанныеНового, ДанныеСтарого, ПеремещаемыеЭлементы)
	Для Каждого КвИзНового Из ДанныеНового Цикл
		УзелНового = КвИзНового.Значение;
		ДочерниеЭлементы = ПолучитьДочерниеЭлементы(УзелНового);
		Если ДочерниеЭлементы = Неопределено ИЛИ ДочерниеЭлементы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ИмяРодителя = КвИзНового.Ключ;
		
		АнализироватьПорядокДочерних(УзелНового, ИмяРодителя, ДанныеСтарого, ПеремещаемыеЭлементы);
	КонецЦикла;
КонецПроцедуры

// Возвращает ключ элемента (Name) из элемента формы или кэша.
//
// Параметры:
//  ЭлементФормы - Структура - данные элемента формы
//  ЭлементКэша - Структура - данные элемента кэша
//
// Возвращаемое значение:
//  Строка, Неопределено - имя элемента или Неопределено
//
&НаКлиенте
Функция ПолучитьИмяЭлемента(ЭлементФормы, ЭлементКэша)
	ИмяСвойстваName = "Name";
	Если ЭлементФормы.Свойство(ИмяСвойстваName) Тогда
		Возврат ЭлементФормы[ИмяСвойстваName];
	КонецЕсли;
	
	Если ЭлементКэша <> Неопределено И ЭлементКэша.Свойство(ИмяСвойстваName) Тогда
		Возврат ЭлементКэша[ИмяСвойстваName];
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура ДобавитьИзмененияИзФормыВЭлемент(ЭлементФормы, ЭлементКэша, ИзмененияЭлемента)
	Для Каждого КлючЗначение Из ЭлементФормы Цикл
		Если мМассивИгнорируемыхСвойств.Найти(КлючЗначение.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗначениеВКэше = ПолучитьЗначениеСвойстваЭлемента(ЭлементКэша, КлючЗначение.Ключ);
		Если НЕ ЗначенияРавны(КлючЗначение.Значение, ЗначениеВКэше) Тогда
			ИзмененияЭлемента.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ПолучитьЗначениеСвойстваЭлемента(ЭлементФормы, Ключ)
	Если ЭлементФормы = Неопределено ИЛИ НЕ ЭлементФормы.Свойство(Ключ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ЭлементФормы[Ключ];
КонецФункции

&НаКлиенте
Процедура ОчиститьНеиспользуемыеСвойстваЭлементаФормы(ЭлементКэша, ЭлементФормы, ИзмененияЭлемента)
	Если ЭлементКэша = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого КлючЗначение Из ЭлементКэша Цикл
		Если мМассивИгнорируемыхСвойств.Найти(КлючЗначение.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЭлементФормы.Свойство(КлючЗначение.Ключ) Тогда
			ИзмененияЭлемента.Вставить(КлючЗначение.Ключ, Неопределено);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИзменяемыеЭлементы(ИзменяемыеЭлементы, ЭлементКэша, ЭлементФормы)
	ИмяЭлемента = ПолучитьИмяЭлемента(ЭлементФормы, ЭлементКэша);
	Если ИмяЭлемента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИзмененияЭлемента = Новый Структура;
	ДобавитьИзмененияИзФормыВЭлемент(ЭлементФормы, ЭлементКэша, ИзмененияЭлемента);
	ОчиститьНеиспользуемыеСвойстваЭлементаФормы(ЭлементКэша, ЭлементФормы, ИзмененияЭлемента);
	Если ИзмененияЭлемента.Количество() > 0 Тогда
		ИзменяемыеЭлементы.Вставить(ИмяЭлемента, ИзмененияЭлемента);
	КонецЕсли;
КонецПроцедуры

// Рекурсивно обходит дерево узлов формы и добавляет в ИзменяемыеЭлементы изменения для каждого узла (включая дочерние).
//
// Параметры:
//  УзелНового - Структура - текущий узел дерева формы
//  ДанныеСтарого - Соответствие - индексация старого дерева (имя - Структура с полем Ссылка)
//  ИзменяемыеЭлементы - Соответствие - накапливаемые изменяемые элементы
//
&НаКлиенте
Процедура ОбновитьИзменяемыеЭлементыДерева(УзелНового, ДанныеСтарого, ИзменяемыеЭлементы)
	ДанныеСтарогоУзла = ДанныеСтарого[УзелНового.name];
	Если ДанныеСтарогоУзла <> Неопределено Тогда
		ДобавитьИзменяемыеЭлементы(ИзменяемыеЭлементы, ДанныеСтарогоУзла.Элемент, УзелНового);
	КонецЕсли;
	ДочерниеЭлементы = ПолучитьДочерниеЭлементы(УзелНового);
	Если ДочерниеЭлементы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Ребенок Из ДочерниеЭлементы Цикл
		ОбновитьИзменяемыеЭлементыДерева(Ребенок, ДанныеСтарого, ИзменяемыеЭлементы);
	КонецЦикла;
КонецПроцедуры

// Строит соответствие "имя элемента - элемент" по массиву элементов кэша.
//
// Параметры:
//  ЭлементыКэша - Массив - массив элементов кэша (с полем Name)
//
// Возвращаемое значение:
//  Соответствие - ключ: Строка (имя), значение: элемент
//
&НаКлиенте
Функция ПостроитьКэшПоИмени(ЭлементыКэша)
	Результат = Новый Соответствие;
	Для Каждого ЭлементКэша Из ЭлементыКэша Цикл
		Результат.Вставить(ЭлементКэша.Name, ЭлементКэша);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Возвращает дочерние элементы узла (поле ChildItems) или Неопределено при их отсутствии.
//
// Параметры:
//  Элемент - Структура - узел дерева с опциональным свойством ChildItems
//
// Возвращаемое значение:
//  Массив, Неопределено - массив дочерних элементов или Неопределено
//
&НаКлиенте
Функция ПолучитьДочерниеЭлементы(Элемент)
	Если НЕ Элемент.Свойство("ChildItems") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Элемент["ChildItems"];
КонецФункции

// Проверяет поля Type, Title и Path реквизита на изменение относительно кэша.
//
// Параметры:
//  Реквизит - Структура - текущее значение реквизита (поля Name, Type, Title, Path)
//  РеквизитКэша - Структура, Неопределено - значение из кэша
//
// Возвращаемое значение:
//  Структура, Неопределено - структура с полем Name и изменёнными полями (Type, Title, Path);
//  Неопределено, если ни одно из полей не изменилось
//
&НаКлиенте
Функция ПолучитьИзмененияРеквизита(Реквизит, РеквизитКэша)
	Результат = Новый Структура("Name", Реквизит.Name);
	ЕстьИзменения = Ложь;
	
	ПоляДляПроверки = Новый Массив;
	ПоляДляПроверки.Добавить("Type");
	ПоляДляПроверки.Добавить("Title");
	ПоляДляПроверки.Добавить("Path");
	
	Для Каждого ИмяПоля Из ПоляДляПроверки Цикл
		ЗначениеТекущее = Неопределено;
		ЗначениеКэша = Неопределено;
		Если Реквизит.Свойство(ИмяПоля) Тогда
			ЗначениеТекущее = Реквизит[ИмяПоля];
		КонецЕсли;
		Если РеквизитКэша <> Неопределено И РеквизитКэша.Свойство(ИмяПоля) Тогда
			ЗначениеКэша = РеквизитКэша[ИмяПоля];
		КонецЕсли;
		Если НЕ ЗначенияРавны(ЗначениеТекущее, ЗначениеКэша) Тогда
			Результат.Вставить(ИмяПоля, ЗначениеТекущее);
			ЕстьИзменения = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЕстьИзменения Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Рекурсивно сравнивает два значения (в т.ч. структуры и массивы). Используется для сравнения реквизитов.
//
// Параметры:
//  Знач1 - Произвольный - первое значение
//  Знач2 - Произвольный - второе значение
//
// Возвращаемое значение:
//  Булево - Истина, если значения равны (в т.ч. по содержимому структур/массивов)
//
&НаКлиенте
Функция ЗначенияРавны(Знач1, Знач2)
	Если Знач1 = Знач2 Тогда
		Возврат Истина;
	КонецЕсли;
	Если ТипЗнч(Знач1) <> ТипЗнч(Знач2) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Знач1) = Тип("Структура") Тогда
		Возврат СравнитьСтруктурыКакСтруктуру(Знач1, Знач2);
	КонецЕсли;
	Если ТипЗнч(Знач1) = Тип("Массив") Тогда
		Возврат СравнитьСтруктурыКакМассив(Знач1, Знач2);
	КонецЕсли;
	Возврат (Знач1 = Знач2);
КонецФункции

&НаКлиенте
Функция СравнитьСтруктурыКакСтруктуру(Знач1, Знач2)
	Если Знач1.Количество() <> Знач2.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого КлючЗначение Из Знач1 Цикл
		Знач2Под = Неопределено;
		Если Знач2.Свойство(КлючЗначение.Ключ) Тогда
			Знач2Под = Знач2[КлючЗначение.Ключ];
		КонецЕсли;
		Если НЕ ЗначенияРавны(КлючЗначение.Значение, Знач2Под) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция СравнитьСтруктурыКакМассив(Знач1, Знач2)
	Если Знач1.Количество() <> Знач2.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 0 По Знач1.ВГраница() Цикл
		Если НЕ ЗначенияРавны(Знач1[Индекс], Знач2[Индекс]) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Создаёт или возвращает кэш по идентификатору (префиксу). Кэш хранит реквизиты и элементы формы.
//
// Параметры:
//  Идентификатор - Строка - идентификатор кэша (Prefix из данных генератора)
//
// Возвращаемое значение:
//  Структура - структура кэша с полями Реквизиты (Соответствие), Элементы (Массив)
//
&НаКлиенте
Функция СоздатьПолучитьКэш(Идентификатор)
	Если Кэш.Свойство(Идентификатор) Тогда
		КэшПоПрефиксу = Кэш[Идентификатор];
	Иначе
		КэшПоПрефиксу = Новый Структура("Реквизиты, Элементы", Новый Соответствие, Новый Массив);
		Кэш.Вставить(Идентификатор, КэшПоПрефиксу);
	КонецЕсли;
	
	Возврат КэшПоПрефиксу;
КонецФункции

// Регистрирует ошибку (заглушка для последующей реализации логирования).
//
// Параметры:
//  ТекстОшибки - Строка - текст сообщения об ошибке
//  ОписаниеОшибки - ОписаниеОшибки - описание исключения
//
&НаКлиенте
Процедура ЗарегистрироватьОшибку(ТекстОшибки, ОписаниеОшибки)
КонецПроцедуры

// Анализирует порядок дочерних элементов одного родителя;
// перемещённые определяются через LIS (наибольшая возрастающая подпоследовательность).
// Элемент перемещения: {Имя, Родитель, Перед} - Перед = перед каким элементом вставить (Неопределено если первым).
//
// Параметры:
//  РодительНовый - Структура - узел нового дерева с полем childItems
//  ИмяРодителя - Строка - имя родительского узла
//  ДанныеСтарого - Соответствие - индексация старого дерева (имя - Структура с полями Родитель, Индекс, Ссылка)
//  МассивПеремещений - Массив - массив, в который добавляются структуры перемещений (Имя, Родитель, Перед)
//
&НаКлиенте
Процедура АнализироватьПорядокДочерних(РодительНовый, ИмяРодителя, ДанныеСтарого, МассивПеремещений)
	
	ДочерниеЭлементы = ПолучитьДочерниеЭлементы(РодительНовый);
	Если ДочерниеЭлементы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтарыеПозиции = Новый Массив;
	УзлыДляАнализа = Новый Массив;
	НовыеИндексыВСписке = Новый Массив; // индекс в списке дочерних для каждого элемента УзлыДляАнализа
	
	КоличествоДетей = ДочерниеЭлементы.Количество();
	Для ИндексВСписке = 0 По КоличествоДетей - 1 Цикл
		Ребенок = ДочерниеЭлементы[ИндексВСписке];
		Перед = Неопределено;
		Если ИндексВСписке + 1 < КоличествоДетей Тогда
			Перед = ДочерниеЭлементы[ИндексВСписке + 1].name;
		КонецЕсли;
		
		ДанныеСтарогоУзла = ДанныеСтарого[Ребенок.name];
		Если ДанныеСтарогоУзла = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ДанныеСтарогоУзла.Родитель <> ИмяРодителя Тогда
			МассивПеремещений.Добавить(Новый Структура("Имя, Родитель, Перед", Ребенок.name, ИмяРодителя, Перед));
		Иначе
			СтарыеПозиции.Добавить(ДанныеСтарогоУзла.Индекс);
			УзлыДляАнализа.Добавить(Ребенок.name);
			НовыеИндексыВСписке.Добавить(ИндексВСписке);
		КонецЕсли;
	КонецЦикла;
	
	// Перемещённые по порядку = все, кто не входит в LIS (в порядке нового списка)
	НеподвижныеИндексы = ПолучитьИндексыLIS(СтарыеПозиции);
	Для Индекс = 0 По УзлыДляАнализа.Количество() - 1 Цикл
		Если НеподвижныеИндексы[Индекс] = Неопределено Тогда
			ПозицияВСписке = НовыеИндексыВСписке[Индекс];
			Перед = Неопределено;
			Если ПозицияВСписке + 1 < КоличествоДетей Тогда
				Перед = ДочерниеЭлементы[ПозицияВСписке + 1].name;
			КонецЕсли;
			МассивПеремещений.Добавить(Новый Структура("Имя, Родитель, Перед", УзлыДляАнализа[Индекс], ИмяРодителя, Перед));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Вычисляет индексы элементов, входящих в наибольшую возрастающую подпоследовательность (LIS).
//
// Параметры:
//  Последовательность - Массив - массив чисел (позиции элементов)
//
// Возвращаемое значение:
//  Соответствие - ключ: Число (индекс в Последовательность), значение: Истина для индексов, входящих в LIS
//
&НаКлиенте
Функция ПолучитьИндексыLIS(Последовательность)
	Результат = Новый Соответствие;
	Количество = Последовательность.Количество();
	Если Количество = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	// dp[i] - длина НВП, заканчивающейся в i; prev[i] - предыдущий индекс в цепочке (-1 если нет)
	Длина = Новый Массив;
	Предыдущий = Новый Массив;
	Счетчик = 0;
	Пока Счетчик < Количество Цикл
		Длина.Добавить(1);
		Предыдущий.Добавить(-1);
		Счетчик = Счетчик + 1;
	КонецЦикла;
	
	Для i = 0 По Количество - 1 Цикл
		Для j = 0 По i - 1 Цикл
			Если Последовательность[j] < Последовательность[i] И (Длина[j] + 1) > Длина[i] Тогда
				Длина[i] = Длина[j] + 1;
				Предыдущий[i] = j;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// Конец одной из самых длинных НВП
	МаксДлина = 1;
	КонецИндекс = 0;
	Для i = 1 По Количество - 1 Цикл
		Если Длина[i] > МаксДлина Тогда
			МаксДлина = Длина[i];
			КонецИндекс = i;
		КонецЕсли;
	КонецЦикла;
	
	// Восстановление индексов, входящих в LIS (обратный проход по prev)
	Текущий = КонецИндекс;
	Пока Текущий >= 0 Цикл
		Результат.Вставить(Текущий, Истина);
		Текущий = Предыдущий[Текущий];
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Рекурсивно индексирует дерево элементов: заполняет ИндексMap (имя узла - Структура с Родитель, Индекс, Ссылка).
//
// Параметры:
//  ТекущийУзел - Структура - текущий узел дерева (name, childItems)
//  ИмяРодителя - Строка, Неопределено - имя родительского узла (Неопределено для корня)
//  ИндексMap - Соответствие - соответствие для накопления данных (имя - Структура)
//
&НаКлиенте
Процедура ИндексироватьДерево(ТекущийУзел, ИмяРодителя, ИндексMap)
	ИндексMap.Вставить(ТекущийУзел.name, Новый Структура("ИмяРодителя, Элемент", ИмяРодителя, ТекущийУзел));
	
	ДочерниеЭлементы = ПолучитьДочерниеЭлементы(ТекущийУзел);
	Если ДочерниеЭлементы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для НомерПорядка = 0 По ДочерниеЭлементы.Количество() - 1 Цикл
		Ребенок = ДочерниеЭлементы[НомерПорядка];
		ИндексироватьДерево(Ребенок, ТекущийУзел.name, ИндексMap);
		//ИндексMap[Ребенок.name].Индекс = НомерПорядка;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура Команда1(Команда)
	ВыполнитьТестирование();
КонецПроцедуры

// Преобразует структуру или соответствие в JSON строку.
//
// Параметры:
//  Объект - Произвольный - Объект для преобразования в JSON
//
// Возвращаемое значение:
// Строка - JSON представление объекта
&НаКлиенте
Функция СтруктураВJSON(Объект) Экспорт
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  "));
	ЗаписатьJSON(ЗаписьJSON, Объект);
	
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

&НаКлиенте
Процедура ВыполнитьТестирование()
	ВсеТестовыеДанные = ПолучитьТестовыеДанныеНаСервере();
	Для Каждого ТестовыеДанные Из ВсеТестовыеДанные Цикл
		Если ОтборТестов <> "" И ТестовыеДанные.Название <> ОтборТестов Тогда
			Продолжить;
		КонецЕсли;
		ВыполнитьТест(ТестовыеДанные);
		
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ВыполнениеТестов

&НаКлиенте
Процедура ВыполнитьТест(ТестовыеДанные)
	СтруктураКэша = ТестовыеДанные.До;
	СтруктураФормы = ТестовыеДанные.После;
	
	Кэш = Новый Структура;
	Кэш.Вставить(СтруктураКэша.Prefix,
		Новый Структура("Реквизиты,Элементы", СтруктураКэша.Attributes, СтруктураКэша.ChildItems));
	
	Изменения = ПолучитьИзмененияФормыДляОбновления(СтруктураФормы);
	
	РезультатСравнения = СтруктураВJSON(Изменения);
	ОжидаемоеЗначение = СтруктураВJSON(ТестовыеДанные.Изменения);
	
	Если РезультатСравнения <> ОжидаемоеЗначение Тогда
		ТекстСообщения = НСтр("ru = 'Тест не прошел: '")
			+ ТестовыеДанные.Название + Символы.ПС
			+ "РЕЗУЛЬТАТ: " + Символы.ПС
			+ РезультатСравнения + Символы.ПС
			+ "ОЖИДАЕМОЕ: " + Символы.ПС
			+ ОжидаемоеЗначение;
	Иначе
		ТекстСообщения = НСтр("ru = 'Тест пройден: '") + ТестовыеДанные.Название;
	КонецЕсли;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТестовыеДанныеНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ТабличныйДокумент = ОбработкаОбъект.ПолучитьМакет("ТестовыеДанные");
	
	РезультатJSON = JSONВСтруктуруНаСервере(ТабличныйДокумент.ПолучитьТекст());
	
	Результат = Новый Массив;
	Для Каждого КлючЗначение Из РезультатJSON Цикл
		Данные = Новый Структура();
		Данные.Вставить("Название", КлючЗначение.Ключ);
		Данные.Вставить("До", КлючЗначение.Значение.before);
		Данные.Вставить("После", КлючЗначение.Значение.after);
		Данные.Вставить("Изменения", КлючЗначение.Значение.expected);
		Результат.Добавить(Данные);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

