#Область ОписаниеПеременных

// Структура, хранящая в себе инициализированные модули формы
&НаКлиенте
Перем мМодули;

// Полное имя метаданных обработки формы
&НаКлиенте
Перем мИдентификаторОбработки;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтотОбъект.HTMLДокумент = "http://127.0.0.1:3456";
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	мМодули = Новый Структура;
	
	мИдентификаторОбработки = ПолучитьИдентификаторОбработкиНаСервере();
	
	Кэш = Новый Структура;
	Кэш.Вставить("Реквизиты", Новый Соответствие);
	Кэш.Вставить("Элементы", Новый Массив);
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура ВыполнитьТесты(Команда)
	ВыполнитьТестирование();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура HTMLДокументПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	Событие = ДанныеСобытия.Event.eventData1C;
	
	Если Событие = Неопределено ИЛИ ТипЗнч(Событие) = Тип("Число") Тогда
		Возврат;
	КонецЕсли;
	Отступ = 2;
	JSON = Событие.data;
	JSON = Сред(JSON, Отступ, СтрДлина(JSON) - Отступ);
	JSON = СтрЗаменить(JSON, "\", "");
	ОбновитьФорму(JSON);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область УправлениеМодулями

&НаСервере
Функция ПолучитьИдентификаторОбработкиНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Возврат ОбработкаОбъект.Метаданные().ПолноеИмя();
КонецФункции

&НаКлиенте
Функция ИнициализироватьМодуль(ИмяМодуля)
	ТекИмя = СтрШаблон("%1.Форма.%2", мИдентификаторОбработки, ИмяМодуля);
	
	// BSLLS:GetFormMethod-off
	Результат = ПолучитьФорму(ТекИмя, , ЭтотОбъект);
	// BSLLS:GetFormMethod-on
	
	Результат.Инициализировать();
	
	мМодули.Вставить(ИмяМодуля, Результат);
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ПолучитьМодуль(ИмяМодуля)
	ФормаМодуля = Неопределено;
	
	Если НЕ мМодули.Свойство(ИмяМодуля, ФормаМодуля) Тогда
		ФормаМодуля = ИнициализироватьМодуль(ИмяМодуля);
		мМодули.Вставить(ИмяМодуля, ФормаМодуля);
	КонецЕсли;
	Возврат ФормаМодуля;
КонецФункции

&НаКлиенте
Функция ПолучитьИзмененияФормы(СтруктураФормы) Экспорт
	Изменения = ПолучитьМодуль("ПолучениеИзменений").ПолучитьИзмененияФормы(ЭтотОбъект, СтруктураФормы);
	Возврат Изменения;
КонецФункции

&НаКлиенте
Процедура СохранитьИзмененияФормы(СтруктураФормы) Экспорт
	ПолучитьМодуль("ПолучениеИзменений").СохранитьИзмененияФормы(СтруктураФормы);
КонецПроцедуры

&НаКлиенте
Функция ЗаполнитьЗначенияДобавляемыхРеквизитов(ДобавляемыеРеквизиты) Экспорт
	Модуль = ПолучитьМодуль("ОбновлениеСвойствЭлементов");
	Результат = Модуль.ЗаполнитьЗначенияДобавляемыхРеквизитов(ДобавляемыеРеквизиты);
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ЗаполнитьЗначенияИзменяемыхРеквизитов(ИзменяемыеРеквизиты) Экспорт
	Модуль = ПолучитьМодуль("ОбновлениеСвойствЭлементов");
	Результат = Модуль.ЗаполнитьЗначенияИзменяемыхРеквизитов(ИзменяемыеРеквизиты);
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ЗаполнитьЗначенияИзменяемыхЭлементов(ИзменяемыеЭлементы) Экспорт
	Модуль = ПолучитьМодуль("ОбновлениеСвойствЭлементов");
	Результат = Модуль.ЗаполнитьЗначенияИзменяемыхЭлементов(ИзменяемыеЭлементы);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ОбновлениеФормы

// Обновляет форму на сервере: передаёт объект обработки и текущий JSON в метод Построить.
//
// Параметры:
//  ПараметрыИзмененияФормы - Структура - данные для обновления формы, передаваемые на сервер
//
&НаСервере
Процедура ОбновитьФормуНаСервере(Знач ПараметрыИзмененияФормы)
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.Построить(ЭтотОбъект, Элементы.ГруппаПросмотр, ПараметрыИзмененияФормы);
КонецПроцедуры

// Обновляет форму по данным JSON. Преобразует JSON в структуру и вызывает обновление на сервере.
//
// Параметры:
//  JSON - Строка - JSON-строка с данными формы
//
&НаКлиенте
Процедура ОбновитьФорму(JSON)
	СтруктураФормы = JSONВСтруктуру(JSON);
	Если СтруктураФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Изменения = ПолучитьИзмененияФормы(СтруктураФормы);
	Если Изменения.ТребуетсяПередачаНаСервер Тогда
		ОбновитьФормуНаСервере(Изменения.ДанныеНаСервер);
	КонецЕсли;
	
	ОбновитьСвойстваЭлементов(Изменения.ДанныеНаКлиент);
	СохранитьИзмененияФормы(СтруктураФормы);
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ОбновитьСвойстваЭлементов(ПараметрыИзмененияФормы)
	ИзменяемыеЭлементы = ПараметрыИзмененияФормы.ИзменяемыеЭлементы;
	Для Каждого СвойстваЭлемента Из ИзменяемыеЭлементы Цикл
		ЭлементФормы = ПолучитьЭлементФормыПоИмени(СвойстваЭлемента.Name);
		ОбновитьСвойстваЭлемента(ЭлементФормы, СвойстваЭлемента);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСвойстваЭлемента(ЭлементФормы, СвойстваЭлемента)
	Для Каждого КлючЗначение Из СвойстваЭлемента Цикл
		ИмяСвойства = КлючЗначение.Ключ;
		ЗначениеСвойства = КлючЗначение.Значение;
		ЭлементФормы[ИмяСвойства] = ЗначениеСвойства;
	КонецЦикла;
КонецПроцедуры


&НаКлиенте
Функция ПолучитьЭлементФормыПоИмени(ИмяЭлемента)
	Возврат Элементы[ИмяЭлемента];
КонецФункции

#Область JSON

// Преобразует JSON-строку в структуру.
//
// Параметры:
//  СтрокаJSON - Строка - JSON-строка для преобразования
//
// Возвращаемое значение:
//  Структура, Неопределено - преобразованная структура; Неопределено при ошибке парсинга
//
&НаКлиенте
Функция JSONВСтруктуру(СтрокаJSON)
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Попытка
		Результат = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		ЗарегистрироватьОшибку(НСтр("ru = 'Ошибка чтения JSON'"), ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
	ЧтениеJSON.Закрыть();
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция JSONВСтруктуруНаСервере(СтрокаJSON)
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Результат = ПрочитатьJSON(ЧтениеJSON);
	
	ЧтениеJSON.Закрыть();
	Возврат Результат;
КонецФункции

// Преобразует структуру или соответствие в JSON строку.
//
// Параметры:
//  Объект - Произвольный - Объект для преобразования в JSON
//
// Возвращаемое значение:
// Строка - JSON представление объекта
&НаКлиенте
Функция СтруктураВJSON(Объект) Экспорт
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  "));
	ЗаписатьJSON(ЗаписьJSON, Объект);
	
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

#КонецОбласти

// Регистрирует ошибку (заглушка для последующей реализации логирования).
//
// Параметры:
//  ТекстОшибки - Строка - текст сообщения об ошибке
//  ОписаниеОшибки - ОписаниеОшибки - описание исключения
//
&НаКлиенте
Процедура ЗарегистрироватьОшибку(ТекстОшибки, ОписаниеОшибки)
КонецПроцедуры

#Область ВыполнениеТестов

&НаКлиенте
Процедура ВыполнитьТестирование()
	ВсеТестовыеДанные = ПолучитьТестовыеДанныеНаСервере();
	Для Каждого ТестовыеДанные Из ВсеТестовыеДанные Цикл
		Если ОтборТестов <> "" И ТестовыеДанные.Название <> ОтборТестов Тогда
			Продолжить;
		КонецЕсли;
		ВыполнитьТест(ТестовыеДанные);
		
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьТест(ТестовыеДанные)
	СтруктураКэша = ТестовыеДанные.До;
	СтруктураФормы = ТестовыеДанные.После;
	
	СохранитьИзмененияФормы(СтруктураКэша);
	Изменения = ПолучитьИзмененияФормы(СтруктураФормы);
	
	РезультатСравнения = СтруктураВJSON(Изменения.ДанныеДляТестирования);
	ОжидаемоеЗначение = СтруктураВJSON(ТестовыеДанные.Изменения);
	
	Если РезультатСравнения <> ОжидаемоеЗначение Тогда
		ТекстСообщения = НСтр("ru = 'Тест не прошел: '")
			+ ТестовыеДанные.Название + Символы.ПС
			+ "РЕЗУЛЬТАТ: " + Символы.ПС
			+ РезультатСравнения + Символы.ПС
			+ "ОЖИДАЕМОЕ: " + Символы.ПС
			+ ОжидаемоеЗначение;
	Иначе
		ТекстСообщения = НСтр("ru = 'Тест пройден: '") + ТестовыеДанные.Название;
	КонецЕсли;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТестовыеДанныеНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ТабличныйДокумент = ОбработкаОбъект.ПолучитьМакет("ТестовыеДанные");
	
	РезультатJSON = JSONВСтруктуруНаСервере(ТабличныйДокумент.ПолучитьТекст());
	
	Результат = Новый Массив;
	Для Каждого КлючЗначение Из РезультатJSON Цикл
		Данные = Новый Структура();
		Данные.Вставить("Название", КлючЗначение.Ключ);
		Данные.Вставить("До", КлючЗначение.Значение.before);
		Данные.Вставить("После", КлючЗначение.Значение.after);
		Данные.Вставить("Изменения", КлючЗначение.Значение.expected);
		Результат.Добавить(Данные);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

#КонецОбласти

#КонецОбласти